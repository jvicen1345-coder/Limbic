# Copy this file to .env and fill in real values before running the app.

# Local development: a plain SQLite file. Production (Vercel): a Turso "libsql://..."
# URL — see the "Deploying" section of README.md. Same adapter, same schema, either way.
DATABASE_URL="file:./dev.db"

# Only needed when DATABASE_URL is a remote libsql:// URL (i.e. Turso). Leave unset for
# local file-based development.
TURSO_AUTH_TOKEN=""

# Used to sign the session cookie (HS256 JWT). Generate your own for real deployments:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-random-secret"

# Powers the "Ask AI to search PubMed" feature on the Search screen (translates a
# plain-language description into a PubMed query). Get a key from console.anthropic.com.
# Without it, AI search silently falls back to using your description as a literal query.
ANTHROPIC_API_KEY=""

# Powers live-sourced Clips (real PT/rehab YouTube Shorts, merged with the curated set in
# lib/clips-static.ts — see lib/clips-live.ts). Get a free key from console.cloud.google.com
# (enable the "YouTube Data API v3" on the project, then create an API key). Without it,
# Clips silently falls back to only the curated static set.
YOUTUBE_API_KEY=""

# Powers real stock-photo fallback images on the Home feed's article cards, for whatever
# didn't get a real og:image (see lib/og-image.ts) — mostly seed/guideline-PDF content,
# which has no og:image to find at all (see lib/topic-image.ts, lib/pexels.ts). Get a free
# key from pexels.com/api. Without it, those cards just render without an image.
PEXELS_API_KEY=""

# Powers "Continue with Google" on the sign-in screen (see lib/google-oauth.ts,
# app/auth/google/route.ts, app/auth/google/callback/route.ts). Create an OAuth 2.0 Client
# ID (Web application) at console.cloud.google.com → APIs & Services → Credentials, with
# https://limbic.center as an Authorized JavaScript origin and
# https://limbic.center/auth/google/callback as an Authorized redirect URI. Without both of
# these set, the "Continue with Google" button doesn't render at all.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Powers "Connect Fitbit" on the Activity Log (see lib/google-health-oauth.ts,
# app/auth/fitbit/*, lib/fitbit-sync.ts). Fitbit's classic Web API is being retired
# (deprecated September 2026) in favor of the Google Health API, so this is now a plain
# Google Cloud OAuth 2.0 client, not a Fitbit developer app: in the Google Cloud Console for
# your project, go to APIs & Services → Credentials → "Enable the API and get an OAuth 2.0
# Client ID" for the Google Health API, choose "Web Server", and set the Authorized redirect
# URI to https://limbic.center/auth/fitbit/callback (the setup wizard suggests
# https://www.google.com as a placeholder — replace it). The
# googlehealth.activity_and_fitness.readonly scope this uses is a Restricted scope, so
# real (non-test) users won't be able to connect until Google approves your app's
# verification/security review — until then, add specific testers under OAuth consent
# screen → Test users. Without both vars set, the "Connect Fitbit" row shows "Coming soon"
# instead of a working button.
GOOGLE_HEALTH_CLIENT_ID=""
GOOGLE_HEALTH_CLIENT_SECRET=""

# Powers "Connect Strava" on the Activity Log (see lib/strava-oauth.ts, app/auth/strava/*,
# lib/strava-sync.ts). Create an app at strava.com/settings/api (Authorization Callback
# Domain: limbic.center). Without both of these set, the "Connect Strava" row doesn't
# render at all.
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""

# Comma-separated allowlist of sign-in emails for site admin accounts — checked against
# both the General sign-in email and a PT license sign-in's email, case-insensitively (see
# lib/session.ts isAdminEmail). Gates admin-only tooling (claiming a /founding-funders spot
# on a visitor's behalf, the "wipe all users" panel — see lib/admin.ts isSiteAdmin) AND
# grants every paid tier's full access (LimbicPro, LimbicStudent, LimbicWellness+) plus
# every .edu-gated student-only area (Boards, the Student Atrium, etc.), all without an
# actual subscription or student email on file — see lib/session.ts getCurrentUser()'s
# overlay and hasStudentAccess(). Leave unset to disable all of the above.
FOUNDING_FUNDERS_ADMIN_EMAILS=""

# Powers real LimbicPro/Student tier billing (see lib/stripe.ts, app/actions/pro.ts,
# app/api/stripe/webhook/route.ts) — see the "Stripe subscriptions" section of README.md
# for full setup steps (Products/Prices, webhook endpoint, Customer Portal activation).
# Without STRIPE_SECRET_KEY set, the Upgrade/Manage membership buttons on
# /pro/membership stay disabled with a "not set up yet" notice — never a fake purchase.
STRIPE_SECRET_KEY=""
# The signing secret for the webhook endpoint you create in the Stripe Dashboard
# (Developers → Webhooks), pointed at https://<your-domain>/api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=""
# Price ids (not Product ids — from the specific $-per-interval Price under each Product)
# for LimbicPro ($25/mo) and LimbicStudent ($5/mo).
STRIPE_PRICE_PRO=""
STRIPE_PRICE_LIMBIC_STUDENT=""
# LimbicWellness+ (see app/(app)/wellness/membership/page.tsx) — billing-only for now, no
# feature gate wired up yet. Two Prices under one Product: $3/mo and $18/yr.
STRIPE_PRICE_WELLNESS_PLUS_MONTHLY=""
STRIPE_PRICE_WELLNESS_PLUS_YEARLY=""
# Clinic PRO (see app/(app)/profile/membership/page.tsx) — billing-only for now, no
# team-seat/clinic-admin feature gate wired up yet. $100/mo.
STRIPE_PRICE_CLINIC=""
# The one-time $40 Founding Funder payment (see /founding-funders, createFoundingFunderCheckout
# in app/actions/founding-funders.ts) — a single Checkout Session in "payment" mode, not a
# subscription, so it's its own Price id rather than joining STRIPE_PRICE_* above.
# TODO: Create one-time $40 Founding Funder product in Stripe dashboard
# Product name: Limbic Founding Funder
# Price: $40 one-time
# Add price ID to STRIPE_FOUNDING_FUNDER_PRICE_ID in .env and Vercel
STRIPE_FOUNDING_FUNDER_PRICE_ID=""

# Powers password-reset emails (see lib/email.ts, requestPasswordResetAction in
# app/actions/auth.ts) — this is what makes "Forgot password?" (and a legacy pre-password
# account's first sign-in attempt, which routes to the same flow) actually deliver a link
# instead of just logging it to the server console. Create a free account at resend.com,
# then verify a sending domain there (Domains → Add Domain, then add the DNS records it
# gives you at your registrar) — an unverified domain can only send to your own Resend
# account email, not real readers. Get the API key from Resend → API Keys.
RESEND_API_KEY=""
# Must be an address on the domain you verified above, e.g.
# "Limbic <noreply@notifications.limbic.center>".
EMAIL_FROM="Limbic <noreply@notifications.limbic.center>"

# Authenticates Vercel Cron's daily hits on /api/cron/migration-reminders,
# /api/cron/refresh-interest-profiles, and /api/cron/sync-fitness-trackers (see
# lib/migration-reminder.ts, lib/fitbit-sync.ts, lib/strava-sync.ts, vercel.json) — Vercel
# sends this as an `Authorization: Bearer <CRON_SECRET>` header automatically once both
# this env var and the vercel.json "crons" entry are in place. Generate your own:
# openssl rand -base64 32. Without it, each route stays disabled (503) rather than running
# unauthenticated.
CRON_SECRET=""
