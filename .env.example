# Copy this file to .env and fill in real values before running the app.

# Local development: a plain SQLite file. Production (Vercel): a Turso "libsql://..."
# URL — see the "Deploying" section of README.md. Same adapter, same schema, either way.
DATABASE_URL="file:./dev.db"

# Only needed when DATABASE_URL is a remote libsql:// URL (i.e. Turso). Leave unset for
# local file-based development.
TURSO_AUTH_TOKEN=""

# Used to sign the session cookie (HS256 JWT). Generate your own for real deployments:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-random-secret"

# Powers the "Ask AI to search PubMed" feature on the Search screen (translates a
# plain-language description into a PubMed query). Get a key from console.anthropic.com.
# Without it, AI search silently falls back to using your description as a literal query.
ANTHROPIC_API_KEY=""
