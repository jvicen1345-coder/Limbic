// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  isGuest   Boolean  @default(false)

  // Real password auth (see lib/password.ts — scrypt, never stored or logged in plaintext)
  // — replaces the old "type any email, you're in" demo sign-in. Null for every account
  // created before this shipped; those accounts go through the same password-reset flow
  // (PasswordResetToken below) as an ordinary "forgot password" to set one, rather than a
  // separate migration path — see lib/session.ts signInWithPassword.
  passwordHash String?

  // Google's stable per-account "sub" claim from its verified ID token (see
  // lib/google-oauth.ts exchangeGoogleCode, lib/session.ts signInWithGoogle) — set the
  // first time an account signs in with Google, whether that's account creation or an
  // existing password/license account linking Google for the first time. The only real
  // signal for "this account has signed in with Google" — passwordHash being null isn't
  // enough on its own, since that's equally true of a pre-password-auth legacy account
  // that has never used Google either. An account can have both set (Google first, a
  // password added later via forgot-password, or vice versa).
  googleId String? @unique

  // Clickwrap assent: set at account creation for every path that creates one (email
  // signup, guest, Google), recording *when* the reader accepted and *which* version of
  // the Terms/Privacy pair they accepted — TERMS_VERSION in lib/legal-terms.ts, which is
  // the "Last updated" date the two documents share. Enforceability of the clauses that
  // only ever matter in a dispute (arbitration and the class-action waiver in Terms §15,
  // the liability cap in §13, indemnification in §14) turns on being able to show
  // specific, affirmative assent to a specific version, which a passive "by signing in
  // you agree" line under the form cannot do. Null for every account created before this
  // shipped, and deliberately not backfilled — writing a date onto those rows would be
  // recording an acceptance that never happened, which is worse than having no record.
  // Re-prompting existing accounts to accept (an interstitial on next sign-in, gated on
  // termsAcceptedAt being null or naming an older TERMS_VERSION) is the follow-up that
  // closes the gap for them; nothing reads these fields yet.
  //
  // Whatever reads them later must treat null as "no recorded acceptance", never as
  // "accepted at an unknown time".
  termsAcceptedAt DateTime?
  termsVersion    String?

  // Account suspension, used by the repeat-infringer termination policy the DMCA page
  // publishes (app/dmca/page.tsx §6) and required by 17 U.S.C. §512(i)(1)(A), which
  // conditions safe harbor on that policy being *reasonably implemented*, not merely
  // written down. A suspension is deliberately not a deletion: the account, its content and
  // the CopyrightNotice rows against it all survive, because the evidence that the policy
  // was actually enforced is the thing §512(i) is asking for. getCurrentUser() returns null
  // while suspendedAt is set and both sign-in paths refuse the account outright, so a
  // suspension takes effect on the next request rather than whenever the session expires.
  suspendedAt     DateTime?
  suspendedReason String?
  copyrightNotices CopyrightNotice[]
  appraisals       StudyAppraisal[]

  // Legacy single "primary license" (sign-in-with-license flow predating password auth, plus
  // whatever CE tracking/admin lookup/hasLicenseAccess still read directly off User instead
  // of the License relation below). Kept in sync with the reader's best License row — most
  // recently verified, else most recently pending, else null — by syncPrimaryLicenseFields
  // in app/actions/license.ts, so none of those other features needed to change when License
  // went from one-per-user to many-per-user (one per state, see License below).
  licenseNumber            String?
  licenseState             String?
  licenseEmail             String?
  licenseExpiration        DateTime?
  licenses                 License[]
  movementLabExerciseRequests MovementLabExerciseRequest[]
  calculatorProfiles       CalculatorProfile[]
  specialtyQuestionAnswers SpecialtyQuestionAnswer[]
  domainQuestionAnswers    DomainQuestionAnswer[]
  differentialResults      DifferentialResult[]
  anatomyConnectResults    AnatomyConnectResult[]
  rehabSequenceResults     RehabSequenceResult[]

  // General (non-PT) sign-in — separate from licenseEmail, which belongs to the PT flow
  // and isn't unique. Signing in again with the same email returns to this same account,
  // same persistence model as licenseNumber for PTs.
  email String? @unique

  // Personal backup email a student can add so they keep access after their .edu email
  // stops working post-graduation (see lib/migration-reminder.ts, app/actions/
  // account-migration.ts, and the "Account Security" section on Profile). Sign-in checks
  // both `email` and `backupEmail` (see lib/session.ts signInWithEmail/signInWithGoogle).
  backupEmail          String?   @unique
  backupEmailAddedAt   DateTime?
  // Set once checkMigrationReminders() sends this account its one-time in-app reminder
  // (see lib/migration-reminder.ts) — also doubles as "don't send again".
  migrationEmailSentAt DateTime?
  // True once backupEmail has been swapped in as the primary email (see
  // app/actions/account-migration.ts makePrimaryEmail).
  accountMigrated      Boolean   @default(false)
  migrationDate        DateTime?

  name          String  @default("Dr. Amara Chen, PT")
  specialty     String  @default("ortho")
  practiceState String  @default("California")
  // Student's school (e.g. "Chapman University") — shown in the sidebar "signed in as"
  // subtitle instead of specialty/practiceState for a hasStudentAccess account (see
  // AppShell.tsx), since specialty/state describe a practicing clinician, not a DPT
  // student. Null for every account until set via the Profile "About you" form (see
  // ProfileForm.tsx) — most non-student accounts will never set it.
  school        String?

  // The student's own institution's Canvas URL (e.g. "chapman.instructure.com"), set via
  // the Profile "About you" form and used only to power the Atrium "Open Canvas" link-out
  // button (see AtriumThisWeekCard.tsx) — Canvas has no single homepage, every school runs
  // its own subdomain. This repo previously built (and then, at explicit user request,
  // fully removed) a real Canvas sign-in/sync integration via a student-generated Personal
  // Access Token — that hit a wall when a school disabled self-service token creation, and
  // was torn out rather than fixed. This field is deliberately just a stored link, not a
  // credential or a synced integration. Null until set; the button prompts the student to
  // add it via Profile when unset.
  canvasUrl String?

  // The clinician's practice/clinic name — shown on the LimbicPRO Clinician Dashboard's
  // patient-brief print document (see app/pro/patient-brief/[patientId]/page.tsx) and its
  // "Prepare for Patient" review step (see components/pro/PreparePatientModal.tsx). Null
  // for every account until set via the Profile "About you" form — the print page omits
  // the "Practice:" line entirely rather than showing a blank one when this is unset.
  clinicName String?

  // Set once the reader flips the "I've added Limbic" switch on the Get the App card (see
  // components/GetTheAppCard.tsx) — collapses that card to a compact done state and hides
  // the shortcut icon next to Refresh on Home (see components/HomeFeed.tsx). Default false
  // so the card/shortcut show for every existing account until they say otherwise.
  getTheAppDismissed Boolean @default(false)

  // Set from the "Founding Funder badge" toggle on Profile (see
  // components/FoundingFunderBadgeToggle.tsx) — hides the badge everywhere it would
  // otherwise show (Profile, Nexus feed/comments/profile, the number next to the name on
  // Home) without touching the underlying FoundingFunder row itself. Default false so the
  // badge is visible by default for every funder until they say otherwise.
  foundingFunderBadgeHidden Boolean @default(false)

  // "light" | "dark" | "system" — set from the sidebar's ThemeToggle and Profile's
  // Appearance section (see components/ThemeToggle.tsx, ThemeSection.tsx). Persisted here
  // for multi-device sync; also mirrored into this browser's localStorage on every change
  // so the blocking init script in app/layout.tsx can set html[data-theme] before first
  // paint without waiting on a database round trip.
  themePreference String @default("system")

  // JSON-encoded string[] of followed topics
  followedTopics Json @default("[]")
  // JSON-encoded { name, required, completed }[] of CE categories
  ceCategories   Json @default("[]")

  // LimbicPro — real billing (see lib/stripe.ts, app/actions/pro.ts,
  // app/api/stripe/webhook/route.ts): set by the Stripe webhook on a confirmed
  // subscription, not by the account holder's own request directly.
  isPro Boolean @default(false)

  // The student tier — "none" | "limbicStudent" (a single $5/mo plan; there used to be a
  // second, higher "studentProBoards" tier, retired in favor of one plan covering
  // everything, including Limbic Agent eligibility — see app/(app)/student/page.tsx).
  // Only purchasable/visible for accounts signed in with a .edu email (see
  // lib/session.ts isStudentEmail) — Limbic Boards and Daily Term are gated on that check,
  // not on this field, since the tier is about what's purchasable, not who can sign in.
  // Same real-billing pattern as isPro above.
  studentTier String @default("none")

  // Stripe billing identity — set the first time this account starts a Checkout session
  // (see app/actions/pro.ts), reused on every later checkout/portal session rather than
  // minting a new Stripe Customer each time. stripeSubscriptionId is whichever LimbicPro/
  // LimbicStudent subscription is currently active (a reader can only be on one paid plan
  // at once today) — the webhook (app/api/stripe/webhook/route.ts) is what actually keeps
  // it and isPro/studentTier in sync.
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique

  // LimbicWellness+ — a separate, additive subscription (not a competing clinician tier
  // like Pro/Student, which share stripeSubscriptionId above since a reader can only be on
  // one of those at once) — a PT can be LimbicPro AND LimbicWellness+ simultaneously, so it
  // gets its own subscription id rather than sharing stripeSubscriptionId. Billing-only for
  // now (see app/(app)/pro/membership/page.tsx) — no feature gate wired to it yet.
  isWellnessPlus             Boolean @default(false)
  // "month" | "year" — which of the two prices is active, purely for display on the
  // manage/cancel card; null when isWellnessPlus is false.
  wellnessPlusInterval       String?
  wellnessPlusSubscriptionId String? @unique

  // Clinic PRO — same additive shape as LimbicWellness+ above (a clinic subscription can
  // coexist with an individual isPro/studentTier one), so it gets its own subscription-id
  // column rather than sharing stripeSubscriptionId. Billing-only for now (see
  // app/(app)/profile/membership/page.tsx) — no team-seat/clinic-admin feature gate wired
  // to it yet.
  isClinicPro             Boolean @default(false)
  clinicProSubscriptionId String? @unique

  // Admin-granted complimentary access to a paid tier, for a specific account rather than
  // every admin (see /admin/accounts, grantAccessAction/revokeAccessAction in
  // app/actions/admin.ts). JSON-encoded GrantArea[] (see lib/session.ts) — a subset of
  // ["pro", "limbicStudent", "wellnessPlus"]. Layered onto isPro/studentTier/isWellnessPlus
  // by getCurrentUser()'s overlay, the same "never write fake billing state into the real
  // columns" pattern the admin-email overlay already uses, so this account's real billing
  // state (and the Stripe webhook that drives it) stays exactly what it really is.
  compedAccess Json @default("[]")

  // Timestamp of the previous home-feed load, captured before it's overwritten with the
  // current one — this is what lets the feed tell "published since you were last here"
  // apart from everything else (see lib/session.ts recordVisitAndGetPrevious).
  lastVisitedAt DateTime?

  // Daily reading-streak tracking, both driven by lib/streak.ts off ReadArticle rows.
  lastReadAt DateTime?
  streakDays Int       @default(0)

  // Nexus (networking) profile fields — blank for accounts that haven't set them up.
  headline   String?
  bio        String?
  // Consent gate: false until the user explicitly joins Nexus (see app/actions/nexus.ts
  // optInToNexusAction/leaveNexusAction) — controls whether they show up in the directory
  // or suggestions, and whether they can view/use any /nexus page at all. Always true for
  // seeded demo/real profiles (see lib/nexus-seed.ts), which can't log in to opt in
  // themselves.
  nexusOptIn Boolean @default(false)

  // JSON-encoded string[] of Home sidebar widget ids the user has hidden (see
  // components/HomeFeed.tsx HOME_WIDGETS) — opt-out, not opt-in, so the default empty array
  // means "show everything", same as every existing account before this field existed.
  hiddenHomeWidgets Json @default("[]")

  // Gates the one-time "pick your interests" screen at app/onboarding (see
  // app/(app)/layout.tsx) for brand-new accounts. Defaults to true (not false) so this
  // field's own rollout doesn't retroactively send every existing account back through
  // onboarding — every account-creation path (lib/session.ts signInWithLicense/
  // signInWithEmail/signInAsGuest) explicitly sets this false only in its own `create`
  // branch, never in an `update` branch, so a returning user is never affected.
  hasOnboarded Boolean @default(true)

  // Gates the one-time "What's your name?" screen at app/onboarding/name (see
  // app/(app)/layout.tsx) — runs before hasOnboarded/hasCompletedOnboarding below, so a
  // brand-new account has a real first-and-last name on file before it ever reaches the
  // topic picker, the role modal, or Home. Same @default(true)-not-false rollout reasoning
  // as hasOnboarded: every real account-creation path (lib/session.ts
  // signUpWithPassword/signInWithGoogle/signInAsGuest) sets this false only in its own
  // `create` branch, never in an `update`, so an existing account is never sent back
  // through it.
  hasSetName Boolean @default(true)

  // "pt" | "pts" | "general" — set from the one-time "How are you using Limbic?" modal
  // (see components/OnboardingRoleModal.tsx, app/(app)/layout.tsx) and editable anytime
  // from Profile's Role section. Drives the reorder-only-never-hide logic in
  // lib/user-role.ts zoneTwoOrder(), which the sidebar (components/AppShell.tsx) uses.
  // Null until the modal (or a Profile edit) sets it.
  userRole String?

  // Gates the "How are you using Limbic?" role modal — same @default(true)-not-false
  // reasoning as hasOnboarded right above, so this field's own rollout doesn't
  // retroactively send every existing account through it. Every real account-creation
  // path (lib/session.ts signUpWithPassword/signInWithGoogle/signInAsGuest) explicitly
  // sets this false only in its own `create` branch, same as hasOnboarded.
  hasCompletedOnboarding Boolean @default(true)

  // Gates the one-time guided product tour (see components/LimbicTour.tsx, app/(app)/
  // home/page.tsx) — fires on Home once a brand-new account has cleared every other
  // onboarding gate above. Same @default(true)-not-false rollout reasoning as
  // hasOnboarded/hasSetName/hasCompletedOnboarding above (an existing account should never
  // suddenly see the tour pop up because this field shipped) — every real account-creation
  // path (lib/session.ts signUpWithPassword/signInWithGoogle/signInAsGuest) sets this false
  // only in its own `create` branch. tourCompletedAt is null until the tour is finished or
  // skipped (see completeTour in app/actions/tour.ts); resetTour clears both so "Replay
  // Tour" on Profile can bring it back.
  hasCompletedTour Boolean   @default(true)
  tourCompletedAt  DateTime?

  // The reader's IANA time zone (e.g. "America/Denver"), reported by their browser and
  // refreshed whenever it changes — see components/TimeZoneSync.tsx, lib/user-time-zone.ts.
  // Every daily-rotating thing in the app is keyed on a calendar date, and those dates used
  // to be read off UTC on a server that runs in UTC, so the day rolled over mid-evening for
  // anyone in the Americas. Null until a browser has reported one (and for any account that
  // predates this field), which lib/user-time-zone.ts treats as "fall back to the request
  // header, then UTC" — i.e. exactly the old behavior.
  timeZone String?

  // Limbic Boards (student daily-habit tools) streak — same nextStreak() logic as the
  // reading streak above, driven off BoardActivity rows instead of ReadArticle ones.
  lastBoardsActivityAt DateTime?
  boardsStreakDays     Int       @default(0)

  // Daily Sharpening's "beat your time" pacing target (see DailySharpeningSession.tsx,
  // recordSharpeningTargetAction in app/actions/daily-completion.ts). Null means "use the
  // standard NPTE 3-question benchmark" (NPTE_THREE_QUESTION_BENCHMARK_SECONDS in
  // lib/board-content.ts). Set to that day's actual completion time whenever a session
  // finishes slower than the benchmark — the reader's own time becomes tomorrow's target —
  // and reset back to null the next time they finish under the real benchmark, so a bad day
  // doesn't permanently soften the goal once they're back on pace.
  boardsSharpeningTargetSeconds Int?

  // Limbic Games (Daily Term / Mini Crossword / Case of the Day) streak — same
  // nextStreak() logic and same "separate streak per feature" reasoning as the reading and
  // Boards streaks above, driven off GameActivity rows instead of ReadArticle/
  // BoardActivity ones. Advanced once per day the first time any of the three games is
  // finished that day (see lib/game-activity.ts), not once per game.
  lastGamesActivityAt DateTime?
  gamesStreakDays     Int       @default(0)

  // The Health & Wellness page's current per-user rotation state (see
  // lib/wellness-rotation.ts). wellnessArticleIds/wellnessVideoIds are JSON-encoded
  // string[] of the ids currently displayed; wellnessOpenedIds is a JSON-encoded string[]
  // of every id the user has ever opened, bounded/pruned to the most recent entries — the
  // Refresh button keeps whatever's still unopened and swaps opened ones for ids outside
  // this list, rather than reshuffling the whole page every time.
  wellnessArticleIds Json @default("[]")
  wellnessVideoIds   Json @default("[]")
  wellnessOpenedIds  Json @default("[]")

  // Every Clip id the user has scrolled past (see lib/clip-rotation.ts), bounded/pruned the
  // same way as wellnessOpenedIds. The curated CLIPS pool (lib/clips-static.ts) is small and
  // finite, so this can't guarantee never repeating — it's what lets the feed put
  // never-seen clips first each visit instead of always restarting from the same c1.
  clipsSeenIds Json @default("[]")

  // Normalized-title fingerprints (see lib/home-grid-rotation.ts titleFingerprint) shown in
  // the Home main feed's grid (see components/HomeFeed.tsx) since the reader last clicked
  // Refresh — a content fingerprint rather than the article's own id, deliberately: Google
  // News RSS's <link> for the same story isn't stable across separate fetches (it's the
  // basis for this app's article ids — see lib/news-live.ts stableId), so id-based seen-
  // tracking couldn't actually recognize "already showed this one" for that content. NOT
  // touched on an ordinary page load, only appended to when Refresh is clicked (see
  // app/actions/home.ts refreshHomeFeedAction), so a normal visit always shows the
  // best-ranked set but Refresh reliably rotates to different articles instead of
  // re-fetching and landing back on the same deterministic top-N. Bounded/pruned the same
  // way as clipsSeenIds/wellnessOpenedIds.
  homeGridSeenFingerprints Json @default("[]")

  // Cached implicit-interest signal for Home feed ranking (see lib/llm-interest-profile.ts,
  // lib/feed.ts rankFeed) — an LLM-generated read on *why* this reader engages with what
  // they engage with, on top of the purely behavioral tag/specialty affinity rankFeed
  // already computes from ReadArticle/SavedArticle history. Null until first generated;
  // ranking works fully without it (see lib/feed.ts) so this only ever sharpens the feed,
  // never gates it. JSON-encoded LlmInterestProfile ({ topics: {label,weight}[], summary,
  // generatedAt }). Deliberately never generated inline on a Home request — an LLM call on
  // every page load doesn't scale — see the daily cron in app/api/cron/
  // refresh-interest-profiles/route.ts, which regenerates it for active readers on a
  // schedule instead.
  llmInterestProfile          Json?
  llmInterestProfileUpdatedAt DateTime?

  // Professional dates (see components/LimbicCalendarWidget.tsx, app/actions/profile.ts
  // updateProfessionalDates) — self-reported deadlines a reader tracks on the Limbic
  // Calendar's orange dots, editable from the Profile "Professional Dates" section.
  // studentTier-only fields (see app/(app)/profile/page.tsx for the visibility gating):
  npteExamDate                DateTime?
  rotationStartDate           DateTime?
  rotationEndDate             DateTime?
  graduationDate              DateTime?
  // Set when the one-time graduation-transition card on Home is dismissed via "Maybe
  // later" (re-shown after 7 days — see components/HomeFeed.tsx) — null means never shown
  // or already past its 7-day snooze.
  graduationTransitionShownAt DateTime?
  // Visible to every account:
  ceuDeadline                 DateTime?
  certificationExpiry         DateTime?
  practiceStartDate           DateTime?

  // DPT Program Timeline (Profile's "Program Timeline" section, see
  // components/ProgramTimelineSection.tsx) — powers the Limbic Student Atrium's phase-aware
  // header and rotation-specific card grid (see lib/dpt-program.ts, app/(app)/student/
  // page.tsx). getCurrentProgramPhase itself reads a fixed Chapman University trimester
  // calendar rather than dptProgramStart/dptGraduation below, so those two are stored for
  // display only; the rotation1-3 fields are matched to whichever trimester
  // getCurrentProgramPhase resolves as the active clinical rotation, by clinicalNumber. NPTE
  // exam date reuses the existing npteExamDate field above rather than duplicating it.
  dptProgramStart String?
  dptGraduation   String?

  rotation1Site       String?
  rotation1City       String?
  rotation1Setting    String?
  rotation1Start      String?
  rotation1End        String?
  rotation1Supervisor String?
  rotation2Site       String?
  rotation2City       String?
  rotation2Setting    String?
  rotation2Start      String?
  rotation2End        String?
  rotation2Supervisor String?
  rotation3Site       String?
  rotation3City       String?
  rotation3Setting    String?
  rotation3Start      String?
  rotation3End        String?
  rotation3Supervisor String?

  // Course syllabi this student has uploaded (see app/actions/syllabus.ts) and the
  // assignments extracted or manually added from them — feeds the Atrium's This Week
  // card, its monthly calendar, and app/(app)/student/assignments/page.tsx.
  syllabi     Syllabus[]
  assignments Assignment[]
  studyCards  StudyCard[]

  // Which of the 235 seeded DPTProgram rows this student picked (see app/actions/
  // dpt-programs.ts setUserProgram) — set during onboarding's Step 2 or from Profile's "Your
  // Program" section, never for the app's own Chapman-hardcoded account (see
  // lib/dpt-program.ts's CHAPMAN_DPT_PROGRAM path, which this field plays no part in). Null
  // for every account that skipped program selection or isn't a PT student.
  dptProgramId Int?
  dptProgram   DPTProgram? @relation(fields: [dptProgramId], references: [id])

  // Reserved for a future "add to my calendar app" / reminder-notification feature — not
  // yet read or written by any code path, but part of this migration's schema per the
  // Limbic Calendar spec so both can be added later without another migration.
  calendarEventIds    Json @default("[]")
  reminderPreferences Json @default("[]")

  // LimbicPRO CE Hours Tracker (/pro/ce-tracker) — separate from ceuDeadline/ceCategories
  // above, which only drive the read-only renewal summary on Profile. These back the
  // tracker's own license-info card (state/expiry/cycle/required hours), with the actual
  // per-course log entries in the CELog relation below.
  ceState         String?
  ceLicenseExpiry DateTime?
  ceRenewalCycle  Int? // years
  ceTotalRequired Float?

  // Limbic Force Lab (/pro/force-lab) — "lbs" | "kg", same fixed-but-app-enforced-value-set
  // convention as HEPTemplate.bodyPart. Null until set from Profile's "Dynamometer Unit
  // Preference" radios; every reader of it (getUserForceUnit in app/actions/force-lab.ts)
  // treats null as "lbs" rather than requiring a migration default, since ForceLabSession
  // rows already default their own `unit` column to "lbs" the same way.
  forceUnit String?

  passwordResetTokens PasswordResetToken[]
  savedArticles       SavedArticle[]
  savedWellness       SavedWellness[]
  savedClips          SavedClip[]
  hepPrograms         HepProgram[]
  hepTemplates        HEPTemplate[]
  readArticles        ReadArticle[]
  boardActivity       BoardActivity[]
  gameActivity        GameActivity[]
  dailyCompletions    DailyCompletion[]
  calendarEvents      UserCalendarEvent[]
  vitalsProfile       VitalsProfile?
  vitalsLogs          VitalsLog[]
  healthSyncToken     HealthSyncToken?
  fitnessConnections  FitnessConnection[]
  metricsLogs         MetricsLog[]
  sleepLogs           SleepLog[]
  moodLogs            MoodLog[]
  ceLogs              CELog[]
  foundingFunder      FoundingFunder?

  // LimbicPRO Clinician Dashboard (/pro/dashboard) — see ClinicalPatient below. All three
  // scope to userId directly (never shared across accounts, no clinicId yet — see that
  // model's own doc comment for the Clinic PRO expansion path).
  clinicalPatients   ClinicalPatient[]
  clinicalNotes      ClinicalNote[]
  preVisitBriefs     PreVisitBrief[]
  visitLogs          VisitLog[]
  clinicalQuestions  ClinicalQuestion[]
  endOfDaySummaries  EndOfDaySummary[]
  treatmentIdeas     TreatmentIdea[]
  redFlagAlerts      RedFlagAlert[]
  patientGoals       PatientGoal[]
  referralSources    ReferralSource[]
  dischargeSummaries DischargeSummary[]

  // Clinic PRO (see Clinic's own doc comment) — clinicAdmin is set only for the one clinic
  // this account owns, if any; clinicMemberships covers every clinic team this account is
  // (or was) a member of, including its own admin row, since Clinic PRO gives every
  // clinician a ClinicMembership rather than treating the admin as a special case.
  clinicAdmin         Clinic?               @relation("ClinicAdmin")
  clinicMemberships   ClinicMembership[]
  transfersFrom       PatientTransfer[]     @relation("TransferFrom")
  transfersTo         PatientTransfer[]     @relation("TransferTo")
  clinicReports       ClinicOutcomeReport[]
  forceLabSessions    ForceLabSession[]
  forceLabAssessments ForceLabAssessment[]
  forceLabComparisons ForceLabComparison[]
  connexionSafetyAssessments ConnexionSafetyAssessment[]
  threeRepMaxTests    ThreeRepMaxTest[]
  sessionExerciseLogs SessionExerciseLog[]

  connectionsSent     Connection[]       @relation("ConnectionRequester")
  connectionsReceived Connection[]       @relation("ConnectionRecipient")
  nexusPosts          NexusPost[]
  nexusPostLikes      NexusPostLike[]
  nexusPostComments   NexusPostComment[]
  messagesSent        NexusMessage[]     @relation("MessageSender")
  messagesReceived    NexusMessage[]     @relation("MessageRecipient")
}

// One notice of claimed copyright infringement received under the DMCA (see
// app/dmca/page.tsx, which publishes where to send them), recorded by an admin from
// /admin/copyright. This table is the evidence that the repeat-infringer policy §512(i)
// requires is *reasonably implemented* — courts read that phrase strictly, and a provider
// that publishes a policy without a record of enforcing it is the fact pattern that loses
// safe harbor. So a notice is never deleted, only resolved: a rejected or reinstated notice
// keeps its row and stops counting as a strike.
//
// Not every notice is a strike. status is the single source of truth for that (see
// NOTICE_STATUSES / countsAsStrike in lib/copyright.ts):
//   "received"  — logged, content still up, nothing decided yet. Not a strike.
//   "removed"   — the material was taken down. Counts as a strike.
//   "rejected"  — facially defective or not infringing; content stays up. Not a strike.
//   "reinstated"— was removed, then restored (valid counter-notice, or withdrawn). Not a strike.
model CopyrightNotice {
  id         String   @id @default(cuid())
  receivedAt DateTime @default(now())

  // The complainant, as given in their notice. Free text and never validated against
  // anything — it is a record of what was claimed, not an assertion that it is true.
  complainantName  String
  complainantEmail String
  // What they say was infringed, and where they say it appears.
  workDescription  String

  // The targeted content. A plain type+id pair rather than two nullable relations: the
  // notice has to outlive the content it is about (a post can be deleted by its own author
  // after a takedown, and the record still has to stand), so this deliberately does not
  // cascade. "post" | "comment" — see NOTICE_TARGET_TYPES in lib/copyright.ts.
  targetType String
  targetId   String

  // Whose content it was. This is the relation strike counts are computed over, so it must
  // be set even when targetId no longer resolves. Cascades on account deletion, which is
  // correct: strikes against an account that no longer exists count for nothing.
  targetAuthorId String
  targetAuthor   User   @relation(fields: [targetAuthorId], references: [id], onDelete: Cascade)

  status     String    @default("received")
  actionedAt DateTime?
  // Free-text admin record — why a notice was rejected, that a counter-notice arrived and
  // when, anything else the file should show later.
  notes      String?

  @@index([targetAuthorId])
  @@index([status])
}

// A PT license submitted through the post-signup verification flow (see
// app/actions/license.ts, components/AddLicenseModal.tsx, app/(app)/admin/licenses/page.tsx)
// — one row per state a reader is licensed in, since a PT can hold licenses in more than one
// state but never two active licenses in the same state. @@unique([userId, state]) is what
// actually enforces that; a "rejected" row for a state doesn't block resubmitting that same
// state (see submitLicenseVerification), it's updated in place rather than blocked.
// licenseNumber is unique per state (see @@unique([state, licenseNumber]) below), not
// globally — a license number identifies exactly one person *within the state that issued
// it*, and nothing more than that.
model License {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  state         String
  licenseNumber String
  fullName      String
  // "pending" | "verified" | "rejected" (see lib/license-verification.ts LICENSE_STATUSES)
  status        String    @default("pending")
  attestation   Boolean   @default(false)
  submittedAt   DateTime  @default(now())
  verifiedAt    DateTime?

  @@unique([userId, state])
  // Per state, not globally. State boards issue license numbers independently of one
  // another, so the same string is legitimately two different practitioners' licenses in
  // two different states — a global unique meant whichever of them signed up second was
  // told their own real credential was "already associated with another account", with no
  // way to proceed. The duplicate-claim check this is really for (a typo, or someone
  // entering a number that isn't theirs) only makes sense within the issuing state anyway.
  @@unique([state, licenseNumber])
}

// A connection request between two users, PT-network-style — "pending" until the
// recipient accepts or declines. Messaging is gated on status == "accepted" (see
// app/actions/nexus.ts).
model Connection {
  id          String    @id @default(cuid())
  requesterId String
  requester   User      @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("ConnectionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  status      String    @default("pending") // pending | accepted | declined
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([requesterId, recipientId])
}

// A Nexus feed post. Seeded rows carry sourceUrl/sourceLabel pointing at the real
// external piece they summarize (a real clinician's real published post) — never a
// fabricated quote, same integrity standard as the rest of the app's content. User-authored
// posts leave both null.
model NexusPost {
  id           String   @id @default(cuid())
  authorId     String
  author       User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  // "text" | "photo" | "video" | "article" — drives which extra fields below are used and
  // how NexusPostCard renders the post; a plain text post ignores all of them.
  type         String   @default("text")
  body         String
  // Article posts only.
  articleTitle String?
  // JSON-encoded string[] of data-URL images — photo posts (1-4 images) and an optional
  // single article cover image. Stored inline (not on disk/object storage) since this app
  // has no file storage configured; images are client-side compressed before upload to
  // keep rows reasonably sized (see lib/media-upload.ts).
  imageUrls    Json     @default("[]")
  // Video posts only — a YouTube URL, embedded the same way as Clips (see lib/meta.ts
  // youtubeEmbedUrl). No raw video upload/storage, for the same reason images are data URLs
  // instead of files: nowhere to durably store large binaries in this deployment.
  videoUrl     String?
  sourceUrl    String?
  sourceLabel  String?
  createdAt    DateTime @default(now())

  // Soft removal for copyright takedowns (§512(c)(1)(C) requires removing or *disabling
  // access to* the material, not destroying it). Deliberately not a hard delete for two
  // reasons: the DMCA page's counter-notification section promises material can be restored
  // in 10-14 business days if a valid counter-notice arrives (§512(g)), which a delete makes
  // impossible; and the removed row is the record that the takedown actually happened.
  //
  // IMPORTANT: a removed post must not appear in any reader-facing query. Every read site
  // spreads `visibleContentWhere` from lib/copyright.ts rather than writing the filter by
  // hand — add new queries the same way, and see that file for the full list.
  removedAt     DateTime?
  removedReason String?

  likes    NexusPostLike[]
  comments NexusPostComment[]
}

model NexusPostLike {
  id        String    @id @default(cuid())
  postId    String
  post      NexusPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([postId, userId])
}

model NexusPostComment {
  id        String    @id @default(cuid())
  postId    String
  post      NexusPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime  @default(now())

  // Same soft-removal contract as NexusPost above — see that field's comment.
  removedAt     DateTime?
  removedReason String?
}

// A direct message between two connected users. senderId/recipientId, not a thread id —
// a "conversation" is just every row where the two ids match either side (see
// lib/nexus.ts).
model NexusMessage {
  id          String    @id @default(cuid())
  senderId    String
  sender      User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  body        String
  createdAt   DateTime  @default(now())
  readAt      DateTime?
}

model SavedArticle {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId String
  createdAt DateTime @default(now())

  // A snapshot of the article's display fields taken at save time — live-sourced articles
  // (Google News guideline/industry/product, PubMed research) aren't guaranteed to still be
  // in the current live fetch batch by the time the reader revisits Saved Articles/
  // Guidelines, so display can't depend on re-resolving articleId against a fresh fetch
  // indefinitely (see app/actions/saved.ts). Null on rows saved before this existed, or on
  // non-article saves (wellness/clips), which fall back to best-effort live resolution.
  type      String?
  specialty String?
  title     String?
  source    String?
  sourceUrl String?
  date      String?
  readMins  Int?
  summary   String?
  tags      Json?

  @@unique([userId, articleId])
}

// A reader's own Limbic Calendar entries (see app/(app)/calendar/page.tsx) — both
// manually added via the Add Event modal and "Save to my calendar" copies of a PT
// platform event (see app/actions/calendar.ts). `type` is a free-text label chosen from
// the Add Event modal's select (Personal | CE Event | Conference | Rotation | Other), not
// an enum — same "no DB-level constraint, whitelist enforced in the server action"
// approach as every other free-text field in this schema (see profile.ts's
// PROFESSIONAL_DATE_FIELDS/EDITABLE_FIELDS pattern).
model UserCalendarEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  date      DateTime
  type      String
  notes     String?
  reminder  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Limbic Vitals (see app/(app)/wellness/metrics/page.tsx) — general wellness tracking, not
// medical advice or condition-specific. VitalsProfile is the reader's self-reported body
// metrics (one row per user); VitalsLog is one row per logged activity, aggregated
// client-side into the weekly bar chart rather than pre-summarized here, same "store the
// raw rows, derive views on read" approach as ReadArticle/BoardActivity elsewhere in this
// schema.
model VitalsProfile {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  age                  Int?
  heightFeet           Int?
  heightInches         Int?
  weightLbs            Float?
  biologicalSex        String?
  activityLevel        String?
  wellnessGoal         String?
  // Set whenever lib/google-health-metrics-sync.ts overwrites weightLbs/heightFeet/
  // heightInches from a connected Google Health account, so BodyMetricsCard can show "synced
  // from Google Health" instead of implying the reader typed these in. A manual Save from
  // that card always wins going forward until the next sync overwrites again — same
  // whoever-wrote-last convention as VitalsLog's apple_health/manual rows.
  googleHealthSyncedAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model VitalsLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  category  String // "cardio" | "strength" | "mobility" | "mindfulness"
  minutes   Int
  activity  String
  notes     String?
  // "manual" (typed in on this page) | "apple_health" (see app/api/health-sync/route.ts,
  // lib/health-sync.ts) — an apple_health row for a given userId/date/category is replaced
  // in place on every re-sync rather than accumulated, so re-running the same day's Shortcut
  // doesn't double-count; a manual row for the same day/category is untouched and additive.
  source    String   @default("manual")
  createdAt DateTime @default(now())
}

// One long-lived API key per user (see lib/health-sync.ts, app/api/health-sync/route.ts) —
// authenticates an Apple Shortcuts automation posting Health app data in, not a browser
// session. Only the SHA-256 hash is stored, same pattern as PasswordResetToken below; the
// raw value is shown to the reader once, at generation time, and never again. Regenerating
// overwrites the row in place (one active key per account, old one immediately stops
// working) rather than keeping a history of retired keys.
model HealthSyncToken {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

// One row per connected fitness-tracker account (see lib/fitbit-oauth.ts, lib/strava-oauth.ts,
// app/auth/fitbit/*, app/auth/strava/*) — a real OAuth2 "Connect" flow, unlike Apple Health's
// Shortcut/upload workarounds above, since Fitbit and Strava both expose a public cloud API.
// accessToken/refreshToken sit in plaintext columns, same trust boundary as every other
// account secret in this schema (googleId, license keys) — protected by DB access alone,
// not field-level encryption. `provider` has no DB-level enum, same reasoning as VitalsLog's
// `category` — checked against a documented string union in the write path instead.
model FitnessConnection {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String // "fitbit" | "strava"
  externalId   String // the provider's own athlete/user id, for reference only
  accessToken  String
  refreshToken String
  // Epoch ms the access token stops working — both providers issue short-lived access
  // tokens (Strava: ~6h, Fitbit: ~8h) that must be refreshed well before every sync.
  expiresAt    DateTime
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())

  @@unique([userId, provider])
}

// Limbic Metrics (see app/(app)/wellness/metrics/page.tsx) — one row per calculator result
// or self-assessment score a reader chooses to save, same "raw rows, derive views on read"
// shape as VitalsLog above rather than one wide row per user. `metric` has no DB-level
// enum, same reasoning as VitalsLog's `category` — checked against a documented string
// union in the write path instead (see lib/metrics.ts).
model MetricsLog {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  metric   String // "bmi" | "hrv" | "vo2max" | "restingHR" | "maxHR" | "singleLegStance" | "sitAndRise" | "wallSit" | "shoulderScratch" | "bodyFat" | "oxygenSaturation" | "bloodGlucose" | "sleepHours" | "caloriesConsumed" | "proteinConsumedG" | "carbsConsumedG" | "fatConsumedG"
  value    Float
  notes    String?
  loggedAt DateTime @default(now())
}

// One row per night, synced from a connected Google Health account's `sleep` data type (see
// lib/google-health-sleep-sync.ts) — no manual-entry path, unlike VitalsLog/MetricsLog,
// since there's no reasonable way for a reader to self-report sleep stages/duration
// accurately after the fact. Upserted in place per date on every sync, same
// re-syncing-is-safe convention as VitalsLog's apple_health rows.
model SleepLog {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Local date the sleep session's wearer fell asleep on — the night of, not the morning
  // woken up, matching how "last night's sleep" is normally talked about.
  date          DateTime
  minutesAsleep Int
  minutesInBed  Int?
  minutesAwake  Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, date])
}

// One row per day — a simple 1 (worst) to 5 (best) mood scale, entered manually (see
// app/actions/mood.ts saveMoodLogAction) or best-effort synced from a connected Google
// Health account's `moods` data type (see lib/mood-sync.ts) when its value maps cleanly onto
// this same 1-5 scale. `source` distinguishes the two so a reader's own manual entry for a
// day is never silently overwritten by a same-day sync (see lib/mood-sync.ts for the exact
// precedence rule) — unlike weight/height/sleep, a reader's own subjective mood entry is the
// more trustworthy signal when both exist for the same day.
model MoodLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  mood      Int
  notes     String?
  source    String // "manual" | "google_health"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

// A single logged CE course entry for LimbicPRO's CE Hours Tracker (/pro/ce-tracker) —
// one row per course, added via addCELog/deleted via deleteCELog (see
// app/actions/pro-toolbox.ts). Hours logged toward renewal is the sum of these rows;
// license/cycle/required-hours preferences live on User (ceState/ceLicenseExpiry/
// ceRenewalCycle/ceTotalRequired above), not here, since they're one value per user rather
// than one per entry.
model CELog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseName  String
  provider    String?
  completedAt DateTime
  hours       Float
  category    String
  createdAt   DateTime @default(now())

  // The completion certificate, if the reader attached one — a data URL (image or PDF),
  // same "no file storage configured for this app" pattern as NexusPost.imageUrls (see
  // lib/media-upload.ts), capped client- and server-side (see MAX_CERTIFICATE_DATA_URL_LENGTH
  // in app/actions/pro-toolbox.ts) so a full-resolution scan doesn't blow past
  // next.config.ts's server-action body size limit. Optional — a log entry is still useful
  // for hour-tracking on its own, e.g. for a course whose certificate arrives later by mail.
  certificateDataUrl String?
}

// A bookmark on a Health & Wellness article or video, snapshot at save time — same
// reasoning as SavedArticle's snapshot: wellness content rotates per-user (see
// lib/wellness-rotation.ts) and isn't guaranteed to still be in anyone's current pool by
// the time the reader revisits Saved Wellness. Kept as its own model rather than folded
// into SavedArticle since wellness items have no specialty/ArticleType and videos carry a
// duration instead of a readMins/summary — a dedicated shape beats optional fields that
// only make sense for one kind or the other.
model SavedWellness {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    String
  kind      String // "article" | "video"
  createdAt DateTime @default(now())

  title     String
  source    String
  // Null for a saved seed wellness article (id "w1".."w4") — those have no external story,
  // they link to our own /wellness/[id] instead (see getWellnessArticleById); keeping this
  // null rather than faking an internal path lets WellnessListItem's sourceUrl-presence
  // check still correctly route back to that page instead of misreading it as external.
  sourceUrl String?
  date      String?
  readMins  Int?
  summary   String?
  duration  String?

  @@unique([userId, itemId])
}

// A bookmark on a Clips short — snapshot at save time, same reasoning as SavedWellness.
// A dedicated model rather than reusing SavedWellness since a clip carries a specialty
// (for the Clips feed's tag) instead of a duration/readMins/summary.
model SavedClip {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clipId    String
  createdAt DateTime @default(now())

  title     String
  source    String
  url       String
  specialty String

  @@unique([userId, clipId])
}

// Per-user, per-day completion state for Daily Term (Wordle) and Limbic Boards' question
// and term of the day — replaces what used to be tracked only in localStorage under an
// unscoped "limbic:wordle:<dateKey>"-style key, which meant every account on the same
// browser saw (and overwrote) the same "completed" state instead of each user having
// their own. elapsedSeconds is the time from first interaction to completion, captured so
// it can be shared to the Nexus feed (see app/actions/daily-completion.ts).
model DailyCompletion {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // "wordle" | "boardQuestion" | "boardTerm" | "crossword"
  dateKey   String
  createdAt DateTime @default(now())

  // Wordle-specific.
  guesses Json? // string[]
  status  String? // "won" | "lost"

  // boardQuestion-specific.
  selectedIndex Int?

  // Which piece of content this row's answer was actually about — a BOARD_QUESTIONS id for
  // kind "boardQuestion", a BOARD_TERMS id for "boardTerm" (see lib/board-content.ts).
  // Needed because the daily pick stopped being a pure function of the date: it's now
  // weighted by NPTE domain and skips what this reader has recently seen (see
  // pickDailyQuestion), so two students can get different questions on the same day and
  // questionForDate(dateKey) can no longer tell you what a past row was answering. Null on
  // every row written before that change, which is exactly what the readers key off — they
  // fall back to the old date-only rotation for those (see boardQuestionForCompletion).
  contentId String?

  // crossword-specific — the full 5x5 grid of what the reader has typed so far ("" for a
  // black cell or one they haven't filled in yet), so an in-progress solve survives a
  // refresh the same way Wordle's guesses do. `status` above doubles for this kind too
  // ("won" once every cell matches the solution — there's no "lost" state, unlike Wordle).
  crosswordCells Json? // string[][]

  elapsedSeconds Int?

  @@unique([userId, kind, dateKey])
}

model HepProgram {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  programName String
  createdAt   DateTime      @default(now())
  exercises   HepExercise[]
}

// One row per article a user has opened — drives both the reading-streak counter and
// "saved but still unread" resurfacing, distinct from SavedArticle (a bookmark, not a
// read receipt).
model ReadArticle {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId      String
  createdAt      DateTime @default(now())
  // 0-1 fraction of the article's scroll extent the reader last reached — drives the Home
  // page "Continue Reading" card (see components/ReadingProgressTracker.tsx, which reports
  // it, and components/ContinueReadingCard.tsx, which renders it).
  scrollProgress Float    @default(0)
  // Bumped on every write to this row, including a bare re-open (see lib/reading.ts
  // recordArticleRead's upsert) as well as a progress update — "most recently touched",
  // not "first read", is what Continue Reading should surface.
  updatedAt      DateTime @default(now()) @updatedAt

  @@unique([userId, articleId])
}

// One row per day a user engages with Limbic Boards (answers the daily question and/or
// reveals the daily term) — drives the Boards streak/calendar the same way ReadArticle
// drives the reading one. Unique per (userId, dateKey) so answering the question and
// revealing the term on the same day only ever counts as one day of activity.
model BoardActivity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateKey   String
  createdAt DateTime @default(now())

  @@unique([userId, dateKey])
}

// One row per day a user finishes at least one Limbic Games game (Daily Term, Mini
// Crossword, or Case of the Day) — drives the Games streak/calendar the same way
// BoardActivity drives the Boards one. Unique per (userId, dateKey) so finishing more than
// one game the same day still only counts as one day of activity.
model GameActivity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateKey   String
  createdAt DateTime @default(now())

  @@unique([userId, dateKey])
}

// A clinician-created grouping of Clinical Calculators results for one visit/patient (see
// /pro/calculators' right-side panel, components/pro/calculators/CalculatorProfilesPanel.tsx)
// — deliberately just a free-text `label`, never a real patient name/DOB/MRN field, so
// nothing here is itself PHI: the clinician is expected to use a non-identifying label
// (initials, room number, session code), same "we don't collect what we don't need"
// reasoning as the rest of this app never asking for identifying patient details anywhere
// else either.
model CalculatorProfile {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String
  // JSON-encoded string[] of calculator testKeys (see lib/calculator-tests.ts) the
  // clinician planned to run for this profile — a checklist, not an access-control list;
  // a result can still be saved for a test that isn't on it (see saveCalculatorResultAction
  // in app/actions/calculator-profiles.ts).
  selectedTests Json               @default("[]")
  // Optional — entered once per visit here rather than re-typed into each individual
  // calculator's own age/sex fields (see CalculatorProfileContext.tsx), so every
  // age/sex-normed test (30-Second Sit-to-Stand, 6MWT) pre-fills from the same source. Never
  // a DOB or other identifying field, same "de-identified" intent as `label` above — just
  // enough to look up the right normative table.
  age           Int?
  sex           String?
  createdAt     DateTime           @default(now())
  results       CalculatorResult[]
}

// One reader's answer to one Board Connections practice question (see
// components/specialty/SpecialtyBoardConnections.tsx and app/actions/specialty-questions.ts)
// on one of the /student/specialties pages — specialty is the route slug (e.g.
// "musculoskeletal", "sports"; every /specialties/sports/<sport> sub-page shares "sports",
// same as they share that hub's specialtyQuestions pool) and questionIndex is that
// question's position within lib/board-content.ts questionsForSpecialty(specialty), which is
// a fixed filter over a static array so the index is stable day to day. dateKey (YYYY-MM-DD)
// is what makes the daily reset automatic — getSpecialtyAnswers only ever reads today's
// dateKey, so a new (userId, specialty, questionIndex, dateKey) row just naturally starts
// unanswered once the date rolls over; nothing deletes or resets the old rows, they just
// stop being read, same pattern as DailyCompletion/BoardActivity elsewhere in this file.
model SpecialtyQuestionAnswer {
  id             String   @id @default(cuid())
  userId         String
  specialty      String
  questionIndex  Int
  selectedAnswer String
  isCorrect      Boolean
  answeredAt     DateTime @default(now())
  dateKey        String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, specialty, questionIndex, dateKey])
}

// Same shape and daily-reset pattern as SpecialtyQuestionAnswer above, just keyed on an
// NPTE domain name (see lib/board-content.ts NPTE_DOMAINS/questionsForDomain) instead of a
// specialty slug — kept as its own model rather than folded into SpecialtyQuestionAnswer's
// `specialty` column since a domain ("Musculoskeletal") and a specialty slug
// ("musculoskeletal") are different identity spaces that happen to overlap in wording; a
// future report reading one table shouldn't silently pick up rows meant for the other.
model DomainQuestionAnswer {
  id             String   @id @default(cuid())
  userId         String
  domain         String
  questionIndex  Int
  selectedAnswer String
  isCorrect      Boolean
  answeredAt     DateTime @default(now())
  dateKey        String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, domain, questionIndex, dateKey])
}

// One row per calendar day (dateKey, YYYY-MM-DD) — the day's case for the Differential
// game (see lib/differential-cases.ts getTodaysCase/getDateKey, app/games/differential).
// caseIndex/condition/clues/category/difficulty are a denormalized snapshot of that day's
// entry from the static case bank at the moment it was first served, so a later edit to
// the static array can't retroactively change what a past day's row says was asked.
model DifferentialCase {
  id         String   @id @default(cuid())
  dateKey    String   @unique
  caseIndex  Int
  condition  String
  clues      Json
  category   String
  difficulty String
  createdAt  DateTime @default(now())
}

// One row per (user, day) — same "first finish wins, nothing resets until the date rolls
// over" pattern as SpecialtyQuestionAnswer above. guesses stores every guess the reader
// submitted that day (in order) so a wrong-then-right sequence is fully recoverable, not
// just the final outcome.
model DifferentialResult {
  id          String   @id @default(cuid())
  userId      String
  dateKey     String
  cluesUsed   Int
  correct     Boolean
  guesses     Json
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey])
}

// One row per calendar day — the day's puzzle for Anatomy Connect (see
// lib/anatomy-connect-logic.ts getTodaysPuzzle/getDateKey, app/games/anatomy-connect).
// `puzzle` is a denormalized snapshot of that day's static-bank entry (title/size/items),
// same reasoning as DifferentialCase above — a later edit to the static array can't
// retroactively change what a past day's puzzle was.
model AnatomyConnectPuzzle {
  id        String   @id @default(cuid())
  dateKey   String   @unique
  puzzle    Json
  createdAt DateTime @default(now())
}

// One row per (user, day) — same "first finish wins" pattern as DifferentialResult above.
model AnatomyConnectResult {
  id          String   @id @default(cuid())
  userId      String
  dateKey     String
  solved      Boolean
  attempts    Int
  timeSeconds Int
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey])
}

// One row per calendar day — which of the static bank's 40 patient cases is today's Rehab
// Sequence case (see lib/rehab-sequence-logic.ts getTodaysRehabCase/getDateKey,
// app/games/rehab-sequence). Just the index, not a full snapshot like DifferentialCase/
// AnatomyConnectPuzzle above — the case's own title/interventions/rationale live entirely
// in the static bank and aren't meant to change, so there's nothing to protect against
// retroactively differing here beyond which index today points at.
model RehabSequenceCase {
  id        String   @id @default(cuid())
  dateKey   String   @unique
  caseIndex Int
  createdAt DateTime @default(now())
}

// One row per (user, day) — same "first finish wins" pattern as DifferentialResult/
// AnatomyConnectResult above. sequenceGiven is the reader's submitted ordering (their
// arrangement of the 8 interventions at submit time), kept for the same "full attempt
// history" reasoning as DifferentialResult.guesses.
model RehabSequenceResult {
  id            String   @id @default(cuid())
  userId        String
  dateKey       String
  correct       Boolean
  attempts      Int
  sequenceGiven Json
  completedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey])
}

// One saved score for one CalculatorProfile — testKey/testName identify which of the 12
// /pro/calculators tools produced it (see lib/calculator-tests.ts for the canonical list);
// value/interpretation are the exact display strings the calculator itself showed at save
// time (e.g. value "41 / 56", interpretation "Low fall risk, 41-56 low, 21-40 medium,
// 0-20 high fall risk") rather than a bare number, so retrieving this later reads the same
// way the clinician saw it live, without this table needing to know each test's own
// scoring scale/units.
model CalculatorResult {
  id             String            @id @default(cuid())
  profileId      String
  profile        CalculatorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  testKey        String
  testName       String
  value          String
  interpretation String
  completedAt    DateTime          @default(now())
}

model HepExercise {
  id        String     @id @default(cuid())
  programId String
  program   HepProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  name      String
  sets      String
  reps      String
  // The load in pounds (a bare number, e.g. "20" — the builder's own field label carries the
  // "lbs"), how often per day/week (e.g. "2x/day"), how long a held position is held (e.g.
  // "5 sec"), and what equipment it takes (e.g. "Resistance band · Yoga mat") — free text at
  // this column's level, same HepTemplateExercise shape lib/hep-templates.ts defines for the
  // JSON exercises columns elsewhere (HEPTemplate, PatientHEPAssignment, SessionExerciseLog);
  // nullable here only because these are real columns added after the model shipped, not
  // because any is optional going forward — createHepAction always sends a value (possibly
  // "").
  weight    String?
  frequency String?
  hold      String?
  equipment String?
  notes     String
  order     Int        @default(0)
  // LimbicPRO-only (see createHepAction, which only ever persists these for user.isPro —
  // a non-pro clinician can still build a text-only HEP, just without attaching media).
  // Links, not uploaded files — this app has no file/blob storage anywhere, so both are
  // just a URL the clinician pastes in (an image URL, and a YouTube/Vimeo/etc. video URL).
  imageUrl  String?
  videoUrl  String?
}

// A saved HEP Builder draft a clinician can reload into the builder later, organized by
// body part in the /hep template library panel (see components/HepTemplateLibrary.tsx).
// Distinct from HepProgram/HepExercise above — a HepProgram is a finished program that's
// been saved for a patient, while a HEPTemplate is a reusable starting point (its
// exercises are never linked to a real HepExercise row, just a JSON snapshot of the
// builder's draft state at save time).
model HEPTemplate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  // One of the fixed body part categories the template panel groups by — see
  // HEP_TEMPLATE_BODY_PARTS in lib/hep-templates.ts. Plain String (not an enum) to match
  // this schema's existing convention for fixed-but-app-enforced value sets (see
  // FoundingFunder.paymentStatus, ConnexionVisitRequest.status).
  bodyPart  String
  // "home" | "clinic" — see HEP_TEMPLATE_KINDS in lib/hep-templates.ts. Defaulted to "home"
  // for every template that existed before this field (the only kind the builder produced
  // until then), so no backfill was needed. Same plain-String convention as bodyPart above.
  kind      String   @default("home")
  // JSON snapshot of the builder's draft exercises at save time — same shape as
  // HepBuilder's DraftExercise minus the client-only `id` field.
  exercises Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientAssignments PatientHEPAssignment[]
}

// LimbicPRO Clinician Dashboard (/pro/dashboard) — a solo PT's own caseload tracker. No PHI
// is stored anywhere in this model or the ones below it: patients are referenced only by a
// clinician-assigned code (e.g. "PT-001"), never a name — see the Add Patient form's HIPAA
// reminder in components/pro/PatientPanel.tsx. Every record scopes to userId directly and
// is never shared across accounts (see the ownership check at the top of every mutating
// action in app/actions/clinician-dashboard.ts).
//
// Clinic PRO expansion: `clinicId` is stamped by transferPatient (app/actions/clinic-pro.ts)
// the first time a patient moves between clinicians on a clinic's team — deliberately NOT
// set by createPatient (app/actions/clinician-dashboard.ts), since this task's constraints
// forbid changing any existing action beyond adding new ones. `userId` above stays the real
// current owner regardless of clinicId; every clinic-wide read (Team Overview, the "Clinic
// Patients Today" tile, the Clinic Outcome Report) is computed by joining ClinicMembership
// -> userId directly rather than depending on this column being populated, so a clinic
// whose members never transfer a patient still gets fully correct team-wide aggregates.
// Nullable and SetNull on delete: a solo clinician's patients never have one, and a
// clinic's patients keep existing on their owning clinician's caseload even if the clinic
// itself is later deleted.
model ClinicalPatient {
  id          String    @id @default(cuid())
  userId      String
  clinicId    String?
  patientCode String
  condition   String
  bodyRegion  String
  specialty   String
  visitCount  Int       @default(0)
  totalVisits Int
  startDate   DateTime  @default(now())
  lastSeen    DateTime?
  nextVisit   DateTime?
  // "active" | "discharged" — plain String, same fixed-but-app-enforced-value-set
  // convention as HEPTemplate.bodyPart above (see that field's comment).
  status      String    @default("active")
  // Clinician's free-text notes on the patient record itself (distinct from the
  // per-visit ClinicalNote log below) — plaintext, same disclaimer as every note-taking
  // surface on this dashboard: the clinician is responsible for not entering PHI here.
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic              Clinic?                @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  outcomes            OutcomeMeasureEntry[]
  hepAssignments      PatientHEPAssignment[]
  clinicalNotes       ClinicalNote[]
  preBriefs           PreVisitBrief[]
  visitLogs           VisitLog[]
  treatmentIdeas      TreatmentIdea[]
  redFlagAlerts       RedFlagAlert[]
  goals               PatientGoal[]
  referralSource      ReferralSource[]
  dischargeSummary    DischargeSummary[]
  transfers           PatientTransfer[]
  forceLabSessions    ForceLabSession[]
  forceLabAssessments ForceLabAssessment[]
  threeRepMaxTests    ThreeRepMaxTest[]
  sessionExerciseLogs SessionExerciseLog[]

  // A clinician's own patient codes must be unique to them (not globally — two different
  // clinicians can each have their own "PT-001") — enforced here, not just checked in
  // createPatient, so a race between two concurrent requests can't both slip through.
  @@unique([userId, patientCode])
}

model OutcomeMeasureEntry {
  id          String   @id @default(cuid())
  patientId   String
  // e.g. "Berg", "TUG", "LEFS", "DASH", "NPRS", "PSFS", "KOOS", "IKDC", "Oswestry", or a
  // clinician-typed "Other" name — see OUTCOME_MEASURES in lib/clinician-dashboard-types.ts.
  measureName String
  score       Float
  maxScore    Float
  notes       String?
  recordedAt  DateTime @default(now())

  patient ClinicalPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model PatientHEPAssignment {
  id          String   @id @default(cuid())
  patientId   String
  // Null when the clinician typed a program name manually instead of picking a saved
  // HEPTemplate (see the "Enter manually" option on the Assign HEP form) — hepName is
  // always set either way, hepId only when it's a real linked template.
  hepId       String?
  hepName     String
  // Snapshot of the template's exercises (or a manually-entered list) at assignment time,
  // same "snapshot, not a live reference" reasoning as HEPTemplate.exercises itself — later
  // edits to the source HEPTemplate shouldn't silently change what a patient was actually
  // given on a past visit.
  exercises   Json?
  assignedAt  DateTime @default(now())
  lastUpdated DateTime @updatedAt

  patient ClinicalPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hep     HEPTemplate?    @relation(fields: [hepId], references: [id], onDelete: SetNull)
}

model ClinicalNote {
  id          String   @id @default(cuid())
  userId      String
  patientId   String
  visitNumber Int
  // "Initial Eval" | "SOAP" | "Progress Note" | "Discharge Summary" — see
  // CLINICAL_NOTE_TYPES in lib/clinician-dashboard-types.ts.
  noteType    String
  // Plaintext — the clinician is responsible for not entering PHI here (see the disclaimer
  // shown on the Add Note form); no encryption-at-rest until the BAA upgrade covers it.
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient ClinicalPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

// Structured record of what a clinician actually did with a patient in one clinic visit —
// distinct from both PatientHEPAssignment above (what the patient does on their own between
// visits) and ClinicalNote above (free-text visit documentation). One row per visit;
// exercises deliberately reuses the same HepTemplateExercise[] JSON shape as
// PatientHEPAssignment.exercises/HEPTemplate.exercises so the dashboard can share one
// display/edit component across all three rather than inventing a second exercise shape
// (see components/pro/dashboard/HepExerciseList.tsx).
model SessionExerciseLog {
  id          String   @id @default(cuid())
  userId      String
  patientId   String
  visitNumber Int
  exercises   Json
  loggedAt    DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient ClinicalPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

// A generated pre-visit brief — either the clinician-facing clinical reasoning aid
// (patientFacing false, from generateClinicalBrief) or the patient-facing progress summary
// reviewed and confirmed through the "Prepare for Patient" modal (patientFacing true,
// confirmedAt set once the clinician clicks through — see confirmPatientBrief in
// app/actions/clinician-dashboard.ts). Both share one model since they're the same kind of
// record at different points in that review flow, not two different concepts.
model PreVisitBrief {
  id            String    @id @default(cuid())
  userId        String
  patientId     String
  brief         String
  patientFacing Boolean   @default(false)
  confirmedAt   DateTime?
  generatedAt   DateTime  @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient ClinicalPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

// One tap of "Yes — Log Visit" on the visit-confirmation banner (see logVisit in
// app/actions/clinician-dashboard.ts) — a durable per-visit record, separate from
// ClinicalPatient.visitCount/lastSeen (which it also bumps), so "was this patient already
// logged today" can be checked without relying on lastSeen alone (a clinician could
// legitimately update lastSeen some other way in the future).
model VisitLog {
  id          String   @id @default(cuid())
  userId      String
  patientId   String
  loggedAt    DateTime @default(now())
  visitNumber Int

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient ClinicalPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

// A quick-capture note-to-self from the Clinical Question Log (right column, default
// workspace state) — "what came up in clinic today that's worth looking into." Answering
// just opens Limbic Agent with the question pre-loaded; `answer`/`answeredAt` are set if a
// future flow ever records the agent's response back onto this row, not by the current
// "open agent" action itself.
// Backs the Clinical Question Log (right column, default workspace state — see
// logClinicalQuestion/answerClinicalQuestion/deleteClinicalQuestion/getUnansweredQuestions
// in app/actions/clinician-dashboard.ts). A later feature pass asked for a model named
// "ClinicalQuestionLog" with this exact same shape — reused this one instead of adding a
// second, identical table under a different name.
model ClinicalQuestion {
  id         String    @id @default(cuid())
  userId     String
  question   String
  answered   Boolean   @default(false)
  answeredAt DateTime?
  answer     String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One row per clinician per calendar day (dateKey, e.g. "2026-08-26") — the source for the
// End of Day summary card on the Morning Rounds view. Upserted by getEndOfDaySummary
// whenever it's computed after 4pm local time; `dismissed` is what makes the card
// disappear for the rest of that day without needing separate client-only state.
model EndOfDaySummary {
  id               String   @id @default(cuid())
  userId           String
  dateKey          String
  patientsSeen     Int
  notesCompleted   Int
  notesOutstanding Int
  ceHoursThisWeek  Float
  dismissed        Boolean  @default(false)
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey])
}

// A future DB-backed home for the condition-intelligence lookup — today
// getConditionIntelligence (see app/actions/clinician-dashboard.ts) reads straight from the
// static conditionIntelligenceMap in lib/condition-intelligence.ts, not this table, same
// "static now, schema ready for later" shape as the Clinic PRO models below. Not written to
// or read from by any action yet.
model ConditionIntelligence {
  id            String   @id @default(cuid())
  condition     String   @unique
  bodyRegion    String
  topMeasures   Json
  episodeLength String
  guideline     String
  boardPearl    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// One "What should I try next?" generation (see generateTreatmentIdeas in
// app/actions/clinician-dashboard.ts) — ideas is a JSON array of the 3 suggestion strings
// the model returned. Only the most recent row per (userId, patientId, today) is what the
// workspace shows; older rows are kept as history, not queried by the UI today.
model TreatmentIdea {
  id          String   @id @default(cuid())
  userId      String
  patientId   String
  ideas       Json
  generatedAt DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient ClinicalPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

// One detected pattern from lib/red-flag-detector.ts's declining_outcomes / no_progress /
// overdue_reassessment checks — dismissed is per-flag (see dismissRedFlagAlert), not
// per-patient, so dismissing one detected issue never hides a different one detected later.
// checkRedFlags is idempotent about re-creating rows for a pattern that's still active and
// not yet dismissed (see that action's own comment for how it avoids duplicate alerts).
model RedFlagAlert {
  id          String   @id @default(cuid())
  userId      String
  patientId   String
  flagType    String
  description String
  dismissed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient ClinicalPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

// One functional goal on a patient's plan of care — either picked from lib/goal-bank.ts's
// pre-written SMART goals via the "Use This Goal" button, or written from scratch (see
// addPatientGoal in app/actions/clinician-dashboard.ts). status is plain String — "active" |
// "met" | "partially-met" | "not-met" — same fixed-but-app-enforced-value-set convention as
// ClinicalPatient.status.
model PatientGoal {
  id        String   @id @default(cuid())
  patientId String
  userId    String
  goalText  String
  category  String
  timeframe String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient ClinicalPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Where a patient came from — captured once, at patient creation (see the Add Patient
// form's optional Referral Source field) — free text, not a fixed list, since referral
// sources vary too much by clinic to enumerate (a referring physician's name, "self-referral",
// "word of mouth", etc). getReferralSourceBreakdown groups these by exact string match for
// the Practice Metrics zone's bar chart.
model ReferralSource {
  id        String   @id @default(cuid())
  userId    String
  patientId String
  source    String
  createdAt DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient ClinicalPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

// A generated discharge summary, reviewed and (optionally) edited by the clinician before
// confirming — see generateDischargeSummaryAction/confirmDischargeSummary in
// app/actions/clinician-dashboard.ts and the "Before You Discharge" modal. `confirmed`
// mirrors PreVisitBrief's own confirmedAt pattern: unconfirmed rows are draft text a
// clinician might still edit or regenerate, never shown on the patient record until
// confirmed.
model DischargeSummary {
  id          String    @id @default(cuid())
  userId      String
  patientId   String
  summary     String
  confirmed   Boolean   @default(false)
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient ClinicalPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

// Clinic PRO — the multi-clinician expansion of the solo dashboard above (see
// ClinicalPatient's own doc comment, which already anticipated this exact `clinicId`
// column). A clinic is billing-gated on User.isClinicPro/clinicProSubscriptionId
// (app/actions/pro.ts subscribeToClinicAction) — that billing tier already existed before
// any of these models did; this is what wires a real feature behind it. One admin per
// clinic (adminUserId is @unique — a clinic has exactly one owner, never co-admins),
// membership rows for every clinician on the team including the admin themselves (so
// "how many active clinicians" is one query, not admin-plus-memberships).
model Clinic {
  id          String   @id @default(cuid())
  name        String
  adminUserId String   @unique
  planType    String   @default("clinic_pro")
  maxSeats    Int      @default(6)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  admin       User                  @relation("ClinicAdmin", fields: [adminUserId], references: [id], onDelete: Cascade)
  memberships ClinicMembership[]
  patients    ClinicalPatient[]
  transfers   PatientTransfer[]
  reports     ClinicOutcomeReport[]
  invites     ClinicInvite[]
}

// One row per clinician on a clinic's team, including the admin (see Clinic's own comment).
// "role" is "admin" | "clinician" (plain String, matching this schema's existing
// fixed-but-app-enforced-value-set convention — see HEPTemplate.bodyPart). "status" is
// "active" | "inactive" — removeClinicMember (app/actions/clinic-pro.ts) sets inactive
// rather than deleting the row, so a former member's patient/transfer history stays
// attached to a real membership record instead of a dangling reference.
model ClinicMembership {
  id         String    @id @default(cuid())
  clinicId   String
  userId     String
  role       String    @default("clinician")
  status     String    @default("active")
  invitedAt  DateTime  @default(now())
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clinicId, userId])
}

// An audit trail entry for reassigning a ClinicalPatient from one clinician to another
// within the same clinic (see transferPatient in app/actions/clinic-pro.ts) — the transfer
// itself updates ClinicalPatient.userId directly; this row is the "who/when/why" history
// shown in the Team Overview tab's "Recent transfers" list, never the ownership record
// itself.
model PatientTransfer {
  id            String   @id @default(cuid())
  clinicId      String
  patientId     String
  fromUserId    String
  toUserId      String
  reason        String?
  transferredAt DateTime @default(now())

  clinic   Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient  ClinicalPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  fromUser User            @relation("TransferFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User            @relation("TransferTo", fields: [toUserId], references: [id], onDelete: Cascade)
}

// A generated, anonymous practice-wide report (see generateClinicReport in
// app/actions/clinic-pro.ts and /pro/clinic-report) — reportData is the full computed JSON
// (practice overview, outcome trends, referral sources, CE compliance) so re-viewing a past
// report from Report History never re-aggregates live data that may have since changed.
// generatedBy is the admin who ran it — always the clinic admin, but kept as its own column
// (rather than assumed from Clinic.adminUserId) in case admin ownership ever transfers.
model ClinicOutcomeReport {
  id             String   @id @default(cuid())
  clinicId       String
  generatedAt    DateTime @default(now())
  dateRangeStart DateTime
  dateRangeEnd   DateTime
  reportData     Json
  generatedBy    String

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [generatedBy], references: [id], onDelete: Cascade)
}

// A pending invitation to join a clinic (see inviteClinicMember/acceptClinicInvite in
// app/actions/clinic-pro.ts) — becomes a ClinicMembership once accepted; the invite row
// itself is kept (accepted: true) rather than deleted, as a record of who invited whom and
// when.
model ClinicInvite {
  id        String   @id @default(cuid())
  clinicId  String
  email     String
  token     String   @unique @default(cuid())
  accepted  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
}

// Limbic Force Lab (/pro/force-lab) — handheld dynamometer session data, manually entered
// or parsed from an ActiveForce screenshot via lib/force-lab-import.ts. patientCode is a
// point-in-time denormalized copy of the linked patient's code (kept even if the patient
// is later renamed/unlinked, since a session's own history — e.g. the /pro/force-lab/
// patient/[patientCode] page's URL — is keyed by the code as typed at save time);
// patientId is the real, nullable FK a session actually links through once a clinician
// runs "Link to Patient" — a session can exist unlinked (patientCode and patientId both
// null) for a quick reading not yet tied to a caseload record.
model ForceLabSession {
  id              String   @id @default(cuid())
  userId          String
  patientCode     String?
  patientId       String?
  muscleGroup     String
  bodyRegion      String
  rightPeak       Float?
  leftPeak        Float?
  rightTimeToPeak Float?
  leftTimeToPeak  Float?
  difference      Float?
  percentDiff     Float?
  lsi             Float?
  unit            String   @default("lbs")
  notes           String?
  // "activeforce_screenshot" when created via parseScreenshot's reviewed-and-confirmed
  // output, "activeforce_paste" when created as one muscle group's row within a
  // createForceLabAssessment() full-assessment import, null for a manually-entered session
  // — see createForceLabSession / createForceLabAssessment.
  importedFrom    String?
  sessionDate     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Set only for the "activeforce_paste" sessions createForceLabAssessment() generates —
  // one ForceLabSession per muscle group in the pasted assessment, all sharing this parent.
  // Null for every manually-entered or screenshot-imported session, which have no assessment
  // to belong to.
  assessmentId          String?
  averageForceLeft      Float?
  averageForceRight     Float?
  forceWeightRatioLeft  Float?
  forceWeightRatioRight Float?
  rep1Left              Float?
  rep1Right             Float?
  rep2Left              Float?
  rep2Right             Float?
  rep3Left              Float?
  rep3Right             Float?
  timeToPeakAvgLeft     Float?
  timeToPeakAvgRight    Float?

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient    ClinicalPatient?    @relation(fields: [patientId], references: [id], onDelete: SetNull)
  // Cascade (not SetNull like `patient` above) — deleteForceLabAssessment is specced to
  // delete "assessment and all linked sessions" together, since these rows only exist as
  // one paste-import's per-muscle-group breakdown, not independent readings a clinician
  // entered on their own.
  assessment ForceLabAssessment? @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

// One full ActiveForce "session" export pasted in via the Paste Assessment tab (see
// lib/force-lab-parser.ts's parseActiveForcePaste and createForceLabAssessment in
// app/actions/force-lab.ts) — one row per paste, covering every muscle group tested that
// visit. Each muscle group within it becomes its own ForceLabSession row (see
// ForceLabSession.assessmentId above) so the existing per-muscle history/trend/strength-
// profile code keeps working unmodified; this model exists on top of that to keep the
// assessment-level metadata (patient weight/age/sex/dominant side, the raw pasted text) and
// let two full visits be compared as a unit rather than muscle-group by muscle-group.
// patientId works the same as ForceLabSession.patientId — nullable, set once a clinician
// links the assessment (directly, or auto-matched by identifier at import time).
model ForceLabAssessment {
  id                String   @id @default(cuid())
  userId            String
  patientId         String?
  // Free-text patient identifier as printed in the ActiveForce export (often, but not
  // always, a clinic's own patient code) — used only to auto-match against
  // ClinicalPatient.patientCode at import time; never displayed as if it were PHI-checked.
  identifier        String?
  assessmentDate    DateTime
  patientWeight     Float?
  patientWeightUnit String?  @default("kg")
  patientAge        Int?
  patientSex        String?
  dominantSide      String?
  musclesTested     Int      @default(0)
  // The full pasted text, kept verbatim for reference/audit (see the Paste Assessment tab's
  // "Raw text is stored for reference" disclaimer) — never re-parsed after save.
  rawText           String
  notes             String?
  // Plain-language AI summary for the Patient Report (see generatePatientReportSummary in
  // app/actions/force-lab.ts) — its own field rather than reusing `notes`, since `notes` is
  // the clinician's own free-text field and already renders verbatim in the Clinical
  // Report; overwriting it here would both destroy that text and leak into a document this
  // feature must not change.
  patientSummary    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient      ClinicalPatient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)
  sessions     ForceLabSession[]
  comparisonsA ForceLabComparison[] @relation("ComparisonA")
  comparisonsB ForceLabComparison[] @relation("ComparisonB")
}

// A saved AI-generated interpretation for one specific pair of ForceLabAssessments (see
// compareAssessments in app/actions/force-lab.ts and generateAssessmentComparison in
// lib/pre-visit-brief.ts) — cached by (assessmentAId, assessmentBId) so re-opening the same
// comparison doesn't regenerate it; "Regenerate" in the UI creates a new row rather than
// overwriting, same reasoning as TreatmentIdea/DischargeSummary keeping prior generations
// instead of updating in place. assessmentA/assessmentB are ordered as picked by the
// clinician (first row selected = A), not date-sorted, since the interpretation prompt
// itself states each assessment's date and reads naturally either direction.
model ForceLabComparison {
  id             String   @id @default(cuid())
  userId         String
  assessmentAId  String
  assessmentBId  String
  interpretation String?
  generatedAt    DateTime @default(now())

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessmentA ForceLabAssessment @relation("ComparisonA", fields: [assessmentAId], references: [id], onDelete: Cascade)
  assessmentB ForceLabAssessment @relation("ComparisonB", fields: [assessmentBId], references: [id], onDelete: Cascade)
}

// Published handheld-dynamometer normative values (lib/force-lab-norms.ts, seeded via
// seedForceLabNorms) — looked up by muscleGroup + an age/sex bucket in getNormativeData
// (app/actions/force-lab.ts). Not user-scoped: this is reference literature data, the same
// for every clinician, same "static + seeded, not per-account" shape as ForceLabNorm's
// muscleGroups/mcidValues siblings in lib/force-lab-muscles.ts and lib/outcome-benchmarks.ts.
model ForceLabNorm {
  id          String   @id @default(cuid())
  muscleGroup String
  bodyRegion  String
  side        String
  ageMin      Int
  ageMax      Int
  sex         String
  meanLbs     Float
  sdLbs       Float
  source      String
  createdAt   DateTime @default(now())
}

// A barbell 3-rep-max test on the Clinician Dashboard (see ThreeRepMaxCard.tsx,
// app/actions/three-rep-max.ts) — separate from Force Lab above, which is handheld-
// dynamometer isometric muscle testing, not a loaded barbell lift. weightLbs is the load
// actually lifted for 3 reps; bodyweightLbs/sex/age are captured per test (not read off the
// patient record, which has none of those fields) so a stale weight/age never silently skews
// a later comparison — same "snapshot, not a live reference" reasoning as
// ForceLabAssessment.patientWeight/patientSex/patientAge. lift/sex are plain strings against
// the fixed value sets in lib/three-rep-max-standards.ts (LIFTS/SEXES), same convention as
// ClinicalPatient.status. The "general population" comparison itself (estimated 1RM,
// bodyweight-and-age-relative strength level) is computed on read in that same lib file, not
// stored here, so tightening the reference standards later doesn't require touching old rows.
model ThreeRepMaxTest {
  id            String   @id @default(cuid())
  userId        String
  patientId     String?
  lift          String
  weightLbs     Float
  bodyweightLbs Float
  sex           String
  age           Int
  testedAt      DateTime @default(now())
  createdAt     DateTime @default(now())

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient ClinicalPatient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
}

// One of the 25 "Founding 25" spots on /founding-funders. Created two ways: self-serve via
// createFoundingFunderCheckout (a real one-time $40 Stripe Checkout, see
// app/actions/founding-funders.ts and app/api/stripe/webhook/route.ts), or manually by an
// admin via claimFoundingSpotAction once an out-of-band payment is confirmed. displayName/
// credential are captured at claim time rather than read live off User (name/specialty) so
// the founding-grid entry stays exactly what was agreed even if the reader later edits their
// profile. `round`/`amount` exist for a possible second cohort after these 25 fill — unused
// (always round 1, amount 40) until that happens.
model FoundingFunder {
  id     String  @id @default(cuid())
  // Nullable, onDelete: SetNull (not Cascade) — deliberately: the /founding-funders page
  // itself promises the Founding 25 listing is permanent ("your name in Limbic forever"),
  // so deleting the underlying account (see app/actions/profile.ts deleteAccountAction)
  // detaches this row from any login instead of erasing it. displayName/credential were
  // already public (the reader/admin chose to show them in the grid), so keeping them
  // around isn't exposing anything new. Also left null entirely for a self-serve Stripe
  // claim — that flow never requires an existing Limbic account (see createFoundingFunderCheckout).
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  displayName String
  credential  String?
  round       Int      @default(1)
  amount      Int      @default(40)
  claimedAt   DateTime @default(now())
  // Kept alongside paymentStatus below (always true when paymentStatus is "confirmed",
  // false otherwise) purely for backward compatibility with existing reads/writes that
  // predate paymentStatus — paymentStatus is the real source of truth for the grid/admin's
  // three-state (empty/pending/confirmed) display.
  confirmed   Boolean  @default(false)

  /// "pending" | "confirmed" | "failed" — set to "pending" the moment a Stripe Checkout
  /// Session is created (createFoundingFunderCheckout), flipped to "confirmed" by the
  /// checkout.session.completed webhook (or the /founding-funders success-page backup check,
  /// or an admin's manual "Confirm Payment" override). A row an admin claims directly
  /// (claimFoundingSpotAction, no Stripe involved) is created already "confirmed". Pending
  /// rows count toward the 25-spot cap the same as confirmed ones, so a spot can't be
  /// oversold while a Checkout Session is still in flight.
  paymentStatus   String    @default("pending")
  stripeSessionId String?
  stripePaymentId String?
  confirmedAt     DateTime?

  // Assigned once, at the moment paymentStatus first becomes "confirmed" (see
  // lib/founding-funders.ts nextFoundingFunderNumber) — the count of already-confirmed
  // funders at that moment, plus one. Null for a pending/failed row. Powers "Founding
  // Funder No. {number}" on Profile (see components/FoundingFunderBadge.tsx) — the short
  // pill shown elsewhere in the app (feed, comments) omits the number.
  foundingFunderNumber Int?
}

// A pre-launch email signup for /founding-funders, collected while
// lib/founding-funders-config.ts's FOUNDING_FUNDERS_OPEN is still false. Deliberately not
// tied to a User — a visitor can join the waitlist without an account existing yet (though
// in practice the page itself is sign-in gated; this just doesn't assume that stays true).
model FoundingFunderWaitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// A home-visit request submitted from The Connexion Method's scheduling form — see
// ConnexionScheduleSection.tsx (embedded on /connexion, /connexion/safety-score, and
// /connexion/delia) and submitVisitRequest in app/actions/connexion.ts. Not tied to a
// User (same reasoning FoundingFunderWaitlist/the old ConnexionWaitlist this replaces
// used) — a visitor can request a visit without a Limbic account existing at all in
// principle, even though every page the form lives on is sign-in gated in practice.
// `status` is a plain admin-managed string, not an enum, matching FoundingFunder's own
// paymentStatus field — see /admin/connexion-visits, updateVisitRequestStatusAction.
model ConnexionVisitRequest {
  id            String    @id @default(cuid())
  name          String
  phone         String
  email         String
  preferredDate DateTime?
  preferredTime String?
  visitReason   String? // dropdown value instead of free text
  status        String    @default("new") // "new" | "contacted" | "scheduled" | "completed"
  createdAt     DateTime  @default(now())

  // Affirmative consent captured at submission. Both the timestamp and the exact wording
  // shown are stored, not just a boolean: consent is only worth anything if you can show
  // *what* the person agreed to on the day, and the on-page copy will be edited over time.
  // The text comes from CONNEXION_CONSENT_TEXT in lib/connexion-consent.ts, which is the
  // same constant the checkbox renders, so the two cannot drift.
  //
  // This form is a first-party collection by Limbic — unlike the clinician tools, where
  // Privacy §2 puts responsibility on the clinician — and a "reason for visit" plus the
  // fall-risk assessment it leads to are consumer health data under the Washington My
  // Health My Data Act and Nevada SB 370, which require affirmative opt-in before
  // collection. Null for rows created before this shipped; those predate the consent and
  // are deliberately not backfilled.
  consentAt   DateTime?
  consentText String?

  safetyAssessments ConnexionSafetyAssessment[]
}

// The Connexion Safety Score™ — a proprietary home safety/fall-risk assessment (see
// lib/connexion-safety-score.ts for the fixed ~52-item rubric this stores scores against),
// administered in person by a licensed Connexion Method PT (isSiteAdmin-gated, same as
// /admin/connexion-visits — this isn't a general LimbicPRO clinician tool, it's the internal
// tool for whoever actually runs Connexion Method visits) and optionally linked back to the
// ConnexionVisitRequest lead it fulfills. See app/actions/connexion-safety-score.ts.
model ConnexionSafetyAssessment {
  id               String   @id @default(cuid())
  administeredById String
  visitRequestId   String?
  clientName       String
  clientAddress    String?
  assessmentDate   DateTime @default(now())

  // JSON.stringify(Record<item key, 0-4 score>) — one entry per item key from
  // SAFETY_SCORE_DOMAINS in lib/connexion-safety-score.ts. Never queried per-item (nothing
  // filters "assessments where grab bars scored a 3"), so one blob beats ~52 rarely-touched
  // integer columns.
  itemScores String

  // Recomputed from itemScores via computeSafetyScoreTotals on every create/update — cached
  // here purely so the assessment list can show a total/risk badge per row without
  // JSON-parsing and rescoring every assessment on every page load. Always written together
  // with itemScores in the same action call; never set independently of it.
  environmentalScore Int
  mobilityScore      Int
  fallRiskScore      Int
  totalScore         Int
  riskLevel          String

  // JSON.stringify(string[]) of selected CRITICAL_FINDING_OPTIONS — the paper form's
  // "Important Safety Override" checkboxes.
  criticalFindings      String  @default("[]")
  criticalFindingsOther String?

  // JSON.stringify({ equipment, location, priority }[]) — the Equipment Recommendations table.
  equipment String @default("[]")
  // JSON.stringify(Record<CAREGIVER_SKILLS key, "demonstrated" | "needsTraining">).
  caregiverSkills String @default("{}")

  priorityActionsUrgent  String?
  priorityActionsSoon    String?
  priorityActionsMonitor String?

  biggestRisk              String?
  mostImportantChange      String?
  equipmentRecommendedNote String?
  caregiverTrainingNote    String?
  followUp                 String? // FOLLOW_UP_OPTIONS key
  followUpOther            String?
  ptRecommendation         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  administeredBy User                   @relation(fields: [administeredById], references: [id], onDelete: Cascade)
  visitRequest   ConnexionVisitRequest? @relation(fields: [visitRequestId], references: [id], onDelete: SetNull)
}

// A fixed-window request counter for "Continue as guest" (see lib/guest-rate-limit.ts,
// guestSignInAction in app/actions/auth.ts) — one row per IP, capping how many throwaway
// guest accounts a single address can mint per window. Not meant to be precise (reads then
// writes count, not atomically incremented under a DB-level lock) — good enough to blunt a
// script hammering the button, which is all this needs to do.
model GuestSignupThrottle {
  ip          String   @id
  windowStart DateTime
  count       Int      @default(1)
}

// Fixed-window failed-sign-in-attempt counter, keyed by the lowercased/trimmed email that
// was attempted (see lib/sign-in-rate-limit.ts, signInAction in app/actions/auth.ts) — same
// shape as GuestSignupThrottle above, just per-email instead of per-IP, and reset on a
// successful sign-in rather than only ever aging out.
model SignInThrottle {
  email       String   @id
  windowStart DateTime
  count       Int      @default(1)
}

// Fixed-window password-reset-request counter, keyed the same way as SignInThrottle above
// (see lib/password-reset-rate-limit.ts, requestPasswordResetAction in
// app/actions/auth.ts) — caps how many reset emails one address can trigger per window,
// independent of whether the address actually has an account (an attacker can't tell the
// difference from the outside, so this counts every request attempt, not just ones that
// found a real user).
model PasswordResetThrottle {
  email       String   @id
  windowStart DateTime
  count       Int      @default(1)
}

// A password-reset link's server-side half (see lib/password.ts, app/actions/auth.ts
// requestPasswordResetAction/resetPasswordAction) — one row per emailed link. Only
// `tokenHash` (a SHA-256 hash of the random token that's actually emailed) is ever stored,
// same reasoning as never storing a plaintext password: a database leak alone can't be
// used to reset anyone's account. Doubles as the migration path for every account that
// predates passwordHash existing (see User.passwordHash) — there's no separate "claim your
// legacy account" flow, a legacy sign-in attempt just routes to the same request-a-reset
// UI a normal "forgot password" would.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// The Profile page's anonymous Suggestion Box (see submitSuggestionAction in
// app/actions/suggestions.ts, the admin-only listing at app/(app)/admin/suggestions) —
// deliberately has no userId/user relation at all, unlike every other per-account model in
// this schema, so a submission can never be traced back to the account that sent it, even
// by an admin reading the raw table. Only visible to a site admin (see lib/admin.ts
// isSiteAdmin), same access pattern as FoundingFunderWaitlist above.
model Suggestion {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())
}

// A clinician-submitted request to add a new exercise to Movement Lab's exercise bank (see
// lib/movement-lab) — surfaced inline when the exercise-name autocomplete on the Clinician
// Dashboard's HEP/Session Exercises editor (components/pro/dashboard/HepExerciseList.tsx)
// finds no match for what was typed. Movement Lab is a hand-curated static TS catalog
// (lib/movement-lab/exercises/*.ts), not a database table, so "approving" a request doesn't
// insert it automatically — same review-queue shape as License above, not an auto-apply
// pipeline; an admin who marks one "added" has manually written it into the right region
// file the normal way, and this row just tracks that the request was fulfilled.
model MovementLabExerciseRequest {
  id     String  @id @default(cuid())
  userId String
  name   String
  // One of MOVEMENT_REGIONS (lib/movement-lab), or null when the requester didn't specify —
  // plain String, same fixed-but-app-enforced value set convention as ClinicalPatient.status.
  region String?
  // The clinician's own context for the request — why they need it, what it should include.
  note   String?
  // "pending" | "added" | "declined" — see MOVEMENT_LAB_REQUEST_STATUSES in
  // lib/movement-lab-requests.ts, same convention as License.status.
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Admin-assigned region tags for Limbic Boards questions (see lib/board-content.ts's static
// BOARD_QUESTIONS — there is no BoardsQuestion table; each question only has a stable string
// `id` like "q1", which `questionId` below references). Powers Limbic Atlas's "Board
// Questions" section (see app/actions/boards-tagging.ts getQuestionsForRegion, called with
// the active zone id) and the admin tagging UI at app/(app)/admin/boards-tagging. SQLite has
// no native array/list column type, so bodyRegions/muscleGroups are stored as JSON-encoded
// string arrays (same pattern as ConnexionSafetyAssessment's criticalFindings/equipment/
// caregiverSkills fields above) rather than a relation table, since a question's tag set is
// small and only ever read/written as a whole.
model BoardsQuestionTag {
  id           String   @id @default(cuid())
  questionId   String   @unique
  bodyRegions  String   @default("[]")
  muscleGroups String   @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Cached Unpaywall open-access lookups, keyed by DOI (see lib/unpaywall-cache.ts's
// getCachedUnpaywall, which every reader of open-access status — the article detail page,
// the Home feed's OpenAccessPill — now goes through instead of calling lib/unpaywall.ts's
// checkUnpaywall live on every request). Kept warm by a daily cron sweep
// (app/api/cron/refresh-unpaywall-cache/route.ts, vercel.json) over the current live
// PubMed pool, so in practice a reader's request is almost always a cache hit rather than
// a live third-party call — getCachedUnpaywall still falls back to a live lookup (and
// writes the result here) on a genuine miss, so a DOI the cron hasn't seen yet (a brand-new
// article, or an old one reached via a direct link) still resolves correctly, just without
// the cache's speed/resilience benefit that one time. Open-access status changes rarely
// once a paper is published, so a generous staleness window (see
// UNPAYWALL_CACHE_STALE_MS in lib/unpaywall-cache.ts) is safe. `bestOaLocation` is
// JSON-encoded (or null) rather than a relation — same reasoning as BoardsQuestionTag's
// JSON-string fields above, it's only ever read/written as one whole object.
model UnpaywallCache {
  doi            String   @id
  isOpenAccess   Boolean
  oaStatus       String
  bestOaLocation String?
  title          String
  journal        String
  checkedAt      DateTime @default(now())
}

// A course syllabus a student pasted in for Limbic AI to extract assignments/exams from
// (see lib/syllabus-parser.ts, app/actions/syllabus.ts) — powers the Atrium's This Week
// card (app/(app)/student/page.tsx) and the assignments management page
// (app/(app)/student/assignments/page.tsx). rawText/parsedAt are null until parseSyllabusFromText
// actually runs; a syllabus added only to hold manually-entered assignments never gets either.
// meetingDays/meetingTimes power the Atrium's Class Schedule strip (see AtriumWeekSchedule.tsx)
// — either extracted by parseSyllabusText from a recurring "MWF 9:00-9:50 AM"-style line in
// the syllabus text, or set/corrected by hand on the syllabus card (see
// updateSyllabusMeetingPattern in app/actions/syllabus.ts). meetingDays is a comma-separated
// list of short day codes ("Mon,Wed,Fri", whitelisted server-side against MEETING_DAY_CODES
// in lib/calendar-events.ts, same "no DB-level enum" reasoning as USER_EVENT_TYPES);
// meetingTimes is a JSON-encoded object mapping a day code to its own free-text time
// (`{"Mon":"10:00 AM-10:50 AM","Fri":"8:30 AM-9:20 AM"}`) — a day can have a different meeting
// time than the others (the same course meeting Monday at 10 and Friday at 8:30 is a real,
// asked-for case), and a day present in meetingDays with no entry here just shows no time.
// Free text as written either way, display-only — no DateTime/timezone math is ever done on
// it, same as every other date-only field in this schema. Both null until a meeting pattern
// is known for this course.
model Syllabus {
  id           String    @id @default(cuid())
  userId       String
  courseCode   String
  courseName   String
  trimester    Int
  year         Int
  uploadedAt   DateTime  @default(now())
  rawText      String?
  parsedAt     DateTime?
  meetingDays  String?
  meetingTimes String?
  location     String?
  // Visual Aids page for this course (see components/student/StudyGuideNotes.tsx) — free
  // text the student writes/pastes (can include a simple pipe-delimited table, rendered by
  // lib/study-notes-markdown.ts). One shared note per course, not a list — "charts, tables,
  // visuals" as one running study document per class, same reasoning as location above
  // being one shared value rather than per-day.
  studyNotes String?
  // Stamped only by Study Guide Creator's write (see writeSlideBreakdown in
  // app/actions/slide-breakdown.ts) — never by a manual edit on the Study Guide pages
  // themselves (updateStudyCard/createStudyCard/updateStudyNotes in
  // app/actions/study-guide.ts leave it alone). Powers the "Updated Xh ago" line on the
  // Study Guide index (see getStudyGuideCourses) — a signal that a slide upload actually
  // landed content, deliberately not muddied by "I fixed a typo on one card" edits.
  studyContentUpdatedAt DateTime?

  user        User         @relation(fields: [userId], references: [id])
  assignments Assignment[]
  studyCards  StudyCard[]
}

// One flashcard/notecard for a course, powering both the Flashcards and Self-Quiz tabs on
// /student/study-guide (see components/student/StudyGuideManager.tsx) — same underlying
// content, two review modes: Flashcards is a plain flip-through, Self-Quiz is a timed
// self-graded round that uses lastResult/reviewCount to resurface cards marked incorrect (or
// never reviewed) before ones already known, a lightweight "review what you don't know first"
// bias rather than a full spaced-repetition scheduler.
model StudyCard {
  id          String    @id @default(cuid())
  userId      String
  syllabusId  String
  front       String
  back        String
  createdAt   DateTime  @default(now())
  reviewCount Int       @default(0)
  lastResult  String? // "correct" | "incorrect" | null (never self-quizzed)

  user     User     @relation(fields: [userId], references: [id])
  syllabus Syllabus @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
}

// One graded item (exam, quiz, assignment, etc.) a student is tracking — parsed from a
// Syllabus (AI-extracted via parseSyllabusFromText) or added by hand via
// addManualAssignment. dueDate is a plain YYYY-MM-DD string, not DateTime — same
// "no timezone, just a calendar date" reasoning as DailyCompletion.dateKey elsewhere in this
// schema, since a due date has no time-of-day component that matters here. Named
// SyllabusAssignment before a since-removed Canvas LMS sync joined it as a second assignment
// source; renamed once it stopped being only syllabus-sourced, and kept the name after Canvas
// support was removed.
model Assignment {
  id          String    @id @default(cuid())
  syllabusId  String?
  userId      String
  title       String
  dueDate     String
  category    String
  courseCode  String
  courseName  String
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  syllabus Syllabus? @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id])
}

// National reference table of CAPTE-accredited DPT programs (see prisma/seed-dpt-programs.ts,
// app/actions/dpt-programs.ts) — a fixed id (not @default(cuid())) since these ids come from
// the source dataset itself and are referenced by that dataset's own id numbering. Every
// column below mirrors that dataset 1:1 (see prisma/dpt-programs-data.json's own field names)
// — a NULL here means "not confirmed in the source," never "zero"/"none": always render it as
// "Not published" in the UI, never as a blank or a 0. creditsMin/Max and clinicalWeeksMin/Max
// are sort/filter-only — the *Raw text columns are what the UI actually displays, since they
// carry detail (e.g. "44 (incl. two 16-wk yr-3 rotations)") the parsed numbers can't.
model DPTProgram {
  id               Int      @id
  stateCode        String
  stateName        String
  region           String
  institution      String
  calendarType     String?
  programLength    String?
  startTerm        String?
  totalCreditsRaw  String?
  creditsMin       Float?
  creditsMax       Float?
  clinicalWeeksRaw String?
  clinicalWeeksMin Float?
  clinicalWeeksMax Float?
  accreditedSince  Int?
  notes            String?
  sourceDomain     String?
  createdAt        DateTime @default(now())

  users           User[]
  outreachRecords InstitutionalOutreach[]

  @@index([stateCode])
  @@index([region])
  @@index([institution])
}

// Admin-only institutional-agreement outreach tracker (see app/(app)/admin/programs/page.tsx,
// app/actions/dpt-programs.ts upsertOutreachRecord) — at most one row per DPTProgram, created
// lazily on first "Update" rather than seeded alongside the 235 programs, so a program with no
// row yet just reads as status "not_contacted" (see getOutreachRecords).
model InstitutionalOutreach {
  id              String    @id @default(cuid())
  programId       Int
  status          String    @default("not_contacted")
  contactName     String?
  contactEmail    String?
  lastContactedAt DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  program DPTProgram @relation(fields: [programId], references: [id])
}

// One cached generalizability score per article, for the automatic score the article
// detail page's "Analyze This Study" panel generates the moment it's expanded (see
// app/actions/research-literacy.ts scoreArticleGeneralizability,
// components/ArticleResearchPanel.tsx). Keyed by the article's own id — articles are
// static/feed content, not a Prisma model, so this is a plain unique string rather than a
// relation. Never expires and is never invalidated: a published study's population,
// setting, sample size and follow-up don't change, so the first score is the only score.
// Second and later readers get it back with no Anthropic call and no loading state.
model GeneralizabilityCache {
  id        String   @id @default(cuid())
  articleId String   @unique
  scoreData Json
  scoredAt  DateTime @default(now())
}

// One cached study breakdown per article — the five-field summary shown on the article
// detail page in place of the publisher's abstract (see lib/article-breakdown.ts,
// app/actions/article-breakdown.ts, components/ArticleBreakdown.tsx). Keyed by the
// article's own id, a plain unique string rather than a relation, for the same reason
// GeneralizabilityCache above is: articles are static/feed content, not a Prisma model.
// Never expires — a published study's abstract doesn't change, so the first breakdown is
// the only breakdown, and every reader after the first gets it with no Anthropic call.
model ArticleBreakdownCache {
  id            String   @id @default(cuid())
  articleId     String   @unique
  breakdownData Json
  generatedAt   DateTime @default(now())
}

// One research appraisal written by an admin (see lib/appraisal.ts, app/(app)/admin/appraisals).
//
// `input` is the whole entry form as typed — sample sizes, an effect estimate, an MCID and
// its citation, the appraiser's own notes. It is stored verbatim and never rewritten,
// because it is the provenance record as much as it is the draft: it shows exactly what
// went into any published appraisal, and everything in it is a fact about a study rather
// than a publisher's text. `sourceAccess` and `doi` are lifted out of that blob into their
// own columns so "every appraisal I wrote from a subscription copy" is one query rather than
// a scan — the question a publisher would actually ask.
model StudyAppraisal {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  // The appraiser. Cascades on account deletion — an appraisal is a signed opinion, and it
  // does not outlive the account that signed it.
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // "draft" | "published" — see APPRAISAL_STATUSES in lib/appraisal.ts.
  status String @default("draft")

  /// The full AppraisalInput as entered. Never contains article text: the form has no field
  /// that accepts any, by design.
  input Json

  // The finished prose. `body` is a string[] of paragraphs, matching Article.body so a
  // published appraisal drops straight into the article feed with no separate renderer.
  summary String
  body    Json

  specialty String @default("ortho")
  tags      Json

  // Lifted out of `input` for querying — see the note above.
  sourceAccess String @default("abstract_only")
  doi          String @default("")

  @@index([authorId])
  @@index([status, publishedAt])
}
