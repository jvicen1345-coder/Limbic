// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  isGuest           Boolean  @default(false)

  // Real password auth (see lib/password.ts — scrypt, never stored or logged in plaintext)
  // — replaces the old "type any email, you're in" demo sign-in. Null for every account
  // created before this shipped; those accounts go through the same password-reset flow
  // (PasswordResetToken below) as an ordinary "forgot password" to set one, rather than a
  // separate migration path — see lib/session.ts signInWithPassword.
  passwordHash      String?

  // Google's stable per-account "sub" claim from its verified ID token (see
  // lib/google-oauth.ts exchangeGoogleCode, lib/session.ts signInWithGoogle) — set the
  // first time an account signs in with Google, whether that's account creation or an
  // existing password/license account linking Google for the first time. The only real
  // signal for "this account has signed in with Google" — passwordHash being null isn't
  // enough on its own, since that's equally true of a pre-password-auth legacy account
  // that has never used Google either. An account can have both set (Google first, a
  // password added later via forgot-password, or vice versa).
  googleId          String?  @unique

  // Legacy single "primary license" (sign-in-with-license flow predating password auth, plus
  // whatever CE tracking/admin lookup/hasLicenseAccess still read directly off User instead
  // of the License relation below). Kept in sync with the reader's best License row — most
  // recently verified, else most recently pending, else null — by syncPrimaryLicenseFields
  // in app/actions/license.ts, so none of those other features needed to change when License
  // went from one-per-user to many-per-user (one per state, see License below).
  licenseNumber     String?  @unique
  licenseState      String?
  licenseEmail      String?
  licenseExpiration DateTime?
  licenses          License[]
  calculatorProfiles CalculatorProfile[]
  specialtyQuestionAnswers SpecialtyQuestionAnswer[]
  differentialResults DifferentialResult[]
  anatomyConnectResults AnatomyConnectResult[]

  // General (non-PT) sign-in — separate from licenseEmail, which belongs to the PT flow
  // and isn't unique. Signing in again with the same email returns to this same account,
  // same persistence model as licenseNumber for PTs.
  email             String?  @unique

  // Personal backup email a student can add so they keep access after their .edu email
  // stops working post-graduation (see lib/migration-reminder.ts, app/actions/
  // account-migration.ts, and the "Account Security" section on Profile). Sign-in checks
  // both `email` and `backupEmail` (see lib/session.ts signInWithEmail/signInWithGoogle).
  backupEmail          String?   @unique
  backupEmailAddedAt   DateTime?
  // Set once checkMigrationReminders() sends this account its one-time in-app reminder
  // (see lib/migration-reminder.ts) — also doubles as "don't send again".
  migrationEmailSentAt DateTime?
  // True once backupEmail has been swapped in as the primary email (see
  // app/actions/account-migration.ts makePrimaryEmail).
  accountMigrated      Boolean   @default(false)
  migrationDate        DateTime?

  name              String   @default("Dr. Amara Chen, PT")
  specialty         String   @default("ortho")
  practiceState     String   @default("California")
  // Student's school (e.g. "Chapman University") — shown in the sidebar "signed in as"
  // subtitle instead of specialty/practiceState for a hasStudentAccess account (see
  // AppShell.tsx), since specialty/state describe a practicing clinician, not a DPT
  // student. Null for every account until set via the Profile "About you" form (see
  // ProfileForm.tsx) — most non-student accounts will never set it.
  school            String?

  // Set once the reader flips the "I've added Limbic" switch on the Get the App card (see
  // components/GetTheAppCard.tsx) — collapses that card to a compact done state and hides
  // the shortcut icon next to Refresh on Home (see components/HomeFeed.tsx). Default false
  // so the card/shortcut show for every existing account until they say otherwise.
  getTheAppDismissed Boolean @default(false)

  // Set from the "Founding Funder badge" toggle on Profile (see
  // components/FoundingFunderBadgeToggle.tsx) — hides the badge everywhere it would
  // otherwise show (Profile, Nexus feed/comments/profile, the number next to the name on
  // Home) without touching the underlying FoundingFunder row itself. Default false so the
  // badge is visible by default for every funder until they say otherwise.
  foundingFunderBadgeHidden Boolean @default(false)

  // "light" | "dark" | "system" — set from the sidebar's ThemeToggle and Profile's
  // Appearance section (see components/ThemeToggle.tsx, ThemeSection.tsx). Persisted here
  // for multi-device sync; also mirrored into this browser's localStorage on every change
  // so the blocking init script in app/layout.tsx can set html[data-theme] before first
  // paint without waiting on a database round trip.
  themePreference String @default("system")

  // JSON-encoded string[] of followed topics
  followedTopics    Json     @default("[]")
  // JSON-encoded { name, required, completed }[] of CE categories
  ceCategories      Json     @default("[]")

  // LimbicPro — real billing (see lib/stripe.ts, app/actions/pro.ts,
  // app/api/stripe/webhook/route.ts): set by the Stripe webhook on a confirmed
  // subscription, not by the account holder's own request directly.
  isPro             Boolean  @default(false)

  // The student tier — "none" | "limbicStudent" (a single $5/mo plan; there used to be a
  // second, higher "studentProBoards" tier, retired in favor of one plan covering
  // everything, including Limbic Agent eligibility — see app/(app)/student/page.tsx).
  // Only purchasable/visible for accounts signed in with a .edu email (see
  // lib/session.ts isStudentEmail) — Limbic Boards and Daily Term are gated on that check,
  // not on this field, since the tier is about what's purchasable, not who can sign in.
  // Same real-billing pattern as isPro above.
  studentTier       String   @default("none")

  // Stripe billing identity — set the first time this account starts a Checkout session
  // (see app/actions/pro.ts), reused on every later checkout/portal session rather than
  // minting a new Stripe Customer each time. stripeSubscriptionId is whichever LimbicPro/
  // LimbicStudent subscription is currently active (a reader can only be on one paid plan
  // at once today) — the webhook (app/api/stripe/webhook/route.ts) is what actually keeps
  // it and isPro/studentTier in sync.
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique

  // LimbicWellness+ — a separate, additive subscription (not a competing clinician tier
  // like Pro/Student, which share stripeSubscriptionId above since a reader can only be on
  // one of those at once) — a PT can be LimbicPro AND LimbicWellness+ simultaneously, so it
  // gets its own subscription id rather than sharing stripeSubscriptionId. Billing-only for
  // now (see app/(app)/pro/membership/page.tsx) — no feature gate wired to it yet.
  isWellnessPlus             Boolean   @default(false)
  // "month" | "year" — which of the two prices is active, purely for display on the
  // manage/cancel card; null when isWellnessPlus is false.
  wellnessPlusInterval       String?
  wellnessPlusSubscriptionId String?   @unique

  // Admin-granted complimentary access to a paid tier, for a specific account rather than
  // every admin (see /admin/accounts, grantAccessAction/revokeAccessAction in
  // app/actions/admin.ts). JSON-encoded GrantArea[] (see lib/session.ts) — a subset of
  // ["pro", "limbicStudent", "wellnessPlus"]. Layered onto isPro/studentTier/isWellnessPlus
  // by getCurrentUser()'s overlay, the same "never write fake billing state into the real
  // columns" pattern the admin-email overlay already uses, so this account's real billing
  // state (and the Stripe webhook that drives it) stays exactly what it really is.
  compedAccess Json @default("[]")

  // Timestamp of the previous home-feed load, captured before it's overwritten with the
  // current one — this is what lets the feed tell "published since you were last here"
  // apart from everything else (see lib/session.ts recordVisitAndGetPrevious).
  lastVisitedAt     DateTime?

  // Daily reading-streak tracking, both driven by lib/streak.ts off ReadArticle rows.
  lastReadAt        DateTime?
  streakDays        Int      @default(0)

  // Nexus (networking) profile fields — blank for accounts that haven't set them up.
  headline          String?
  bio               String?
  // Consent gate: false until the user explicitly joins Nexus (see app/actions/nexus.ts
  // optInToNexusAction/leaveNexusAction) — controls whether they show up in the directory
  // or suggestions, and whether they can view/use any /nexus page at all. Always true for
  // seeded demo/real profiles (see lib/nexus-seed.ts), which can't log in to opt in
  // themselves.
  nexusOptIn        Boolean  @default(false)

  // JSON-encoded string[] of Home sidebar widget ids the user has hidden (see
  // components/HomeFeed.tsx HOME_WIDGETS) — opt-out, not opt-in, so the default empty array
  // means "show everything", same as every existing account before this field existed.
  hiddenHomeWidgets Json     @default("[]")

  // Gates the one-time "pick your interests" screen at app/onboarding (see
  // app/(app)/layout.tsx) for brand-new accounts. Defaults to true (not false) so this
  // field's own rollout doesn't retroactively send every existing account back through
  // onboarding — every account-creation path (lib/session.ts signInWithLicense/
  // signInWithEmail/signInAsGuest) explicitly sets this false only in its own `create`
  // branch, never in an `update` branch, so a returning user is never affected.
  hasOnboarded      Boolean  @default(true)

  // "pt" | "pts" | "general" — set from the one-time "How are you using Limbic?" modal
  // (see components/OnboardingRoleModal.tsx, app/(app)/layout.tsx) and editable anytime
  // from Profile's Role section. Drives the reorder-only-never-hide logic in
  // lib/user-role.ts zoneTwoOrder(), which the sidebar (components/AppShell.tsx) uses.
  // Null until the modal (or a Profile edit) sets it.
  userRole          String?

  // Gates the "How are you using Limbic?" role modal — same @default(true)-not-false
  // reasoning as hasOnboarded right above, so this field's own rollout doesn't
  // retroactively send every existing account through it. Every real account-creation
  // path (lib/session.ts signUpWithPassword/signInWithGoogle/signInAsGuest) explicitly
  // sets this false only in its own `create` branch, same as hasOnboarded.
  hasCompletedOnboarding Boolean @default(true)

  // Limbic Boards (student daily-habit tools) streak — same nextStreak() logic as the
  // reading streak above, driven off BoardActivity rows instead of ReadArticle ones.
  lastBoardsActivityAt DateTime?
  boardsStreakDays     Int      @default(0)

  // Daily Sharpening's "beat your time" pacing target (see DailySharpeningSession.tsx,
  // recordSharpeningTargetAction in app/actions/daily-completion.ts). Null means "use the
  // standard NPTE 3-question benchmark" (NPTE_THREE_QUESTION_BENCHMARK_SECONDS in
  // lib/board-content.ts). Set to that day's actual completion time whenever a session
  // finishes slower than the benchmark — the reader's own time becomes tomorrow's target —
  // and reset back to null the next time they finish under the real benchmark, so a bad day
  // doesn't permanently soften the goal once they're back on pace.
  boardsSharpeningTargetSeconds Int?

  // Limbic Games (Daily Term / Mini Crossword / Case of the Day) streak — same
  // nextStreak() logic and same "separate streak per feature" reasoning as the reading and
  // Boards streaks above, driven off GameActivity rows instead of ReadArticle/
  // BoardActivity ones. Advanced once per day the first time any of the three games is
  // finished that day (see lib/game-activity.ts), not once per game.
  lastGamesActivityAt DateTime?
  gamesStreakDays     Int      @default(0)

  // The Health & Wellness page's current per-user rotation state (see
  // lib/wellness-rotation.ts). wellnessArticleIds/wellnessVideoIds are JSON-encoded
  // string[] of the ids currently displayed; wellnessOpenedIds is a JSON-encoded string[]
  // of every id the user has ever opened, bounded/pruned to the most recent entries — the
  // Refresh button keeps whatever's still unopened and swaps opened ones for ids outside
  // this list, rather than reshuffling the whole page every time.
  wellnessArticleIds Json @default("[]")
  wellnessVideoIds   Json @default("[]")
  wellnessOpenedIds  Json @default("[]")

  // Every Clip id the user has scrolled past (see lib/clip-rotation.ts), bounded/pruned the
  // same way as wellnessOpenedIds. The curated CLIPS pool (lib/clips-static.ts) is small and
  // finite, so this can't guarantee never repeating — it's what lets the feed put
  // never-seen clips first each visit instead of always restarting from the same c1.
  clipsSeenIds Json @default("[]")

  // Normalized-title fingerprints (see lib/home-grid-rotation.ts titleFingerprint) shown in
  // the Home main feed's grid (see components/HomeFeed.tsx) since the reader last clicked
  // Refresh — a content fingerprint rather than the article's own id, deliberately: Google
  // News RSS's <link> for the same story isn't stable across separate fetches (it's the
  // basis for this app's article ids — see lib/news-live.ts stableId), so id-based seen-
  // tracking couldn't actually recognize "already showed this one" for that content. NOT
  // touched on an ordinary page load, only appended to when Refresh is clicked (see
  // app/actions/home.ts refreshHomeFeedAction), so a normal visit always shows the
  // best-ranked set but Refresh reliably rotates to different articles instead of
  // re-fetching and landing back on the same deterministic top-N. Bounded/pruned the same
  // way as clipsSeenIds/wellnessOpenedIds.
  homeGridSeenFingerprints Json @default("[]")

  // Cached implicit-interest signal for Home feed ranking (see lib/llm-interest-profile.ts,
  // lib/feed.ts rankFeed) — an LLM-generated read on *why* this reader engages with what
  // they engage with, on top of the purely behavioral tag/specialty affinity rankFeed
  // already computes from ReadArticle/SavedArticle history. Null until first generated;
  // ranking works fully without it (see lib/feed.ts) so this only ever sharpens the feed,
  // never gates it. JSON-encoded LlmInterestProfile ({ topics: {label,weight}[], summary,
  // generatedAt }). Deliberately never generated inline on a Home request — an LLM call on
  // every page load doesn't scale — see the daily cron in app/api/cron/
  // refresh-interest-profiles/route.ts, which regenerates it for active readers on a
  // schedule instead.
  llmInterestProfile          Json?
  llmInterestProfileUpdatedAt DateTime?

  // Professional dates (see components/LimbicCalendarWidget.tsx, app/actions/profile.ts
  // updateProfessionalDates) — self-reported deadlines a reader tracks on the Limbic
  // Calendar's orange dots, editable from the Profile "Professional Dates" section.
  // studentTier-only fields (see app/(app)/profile/page.tsx for the visibility gating):
  npteExamDate      DateTime?
  rotationStartDate DateTime?
  rotationEndDate   DateTime?
  graduationDate    DateTime?
  // Set when the one-time graduation-transition card on Home is dismissed via "Maybe
  // later" (re-shown after 7 days — see components/HomeFeed.tsx) — null means never shown
  // or already past its 7-day snooze.
  graduationTransitionShownAt DateTime?
  // Visible to every account:
  ceuDeadline         DateTime?
  certificationExpiry DateTime?
  practiceStartDate   DateTime?

  // Reserved for a future "add to my calendar app" / reminder-notification feature — not
  // yet read or written by any code path, but part of this migration's schema per the
  // Limbic Calendar spec so both can be added later without another migration.
  calendarEventIds    Json @default("[]")
  reminderPreferences Json @default("[]")

  // LimbicPRO CE Hours Tracker (/pro/ce-tracker) — separate from ceuDeadline/ceCategories
  // above, which only drive the read-only renewal summary on Profile. These back the
  // tracker's own license-info card (state/expiry/cycle/required hours), with the actual
  // per-course log entries in the CELog relation below.
  ceState         String?
  ceLicenseExpiry DateTime?
  ceRenewalCycle  Int? // years
  ceTotalRequired Float?

  passwordResetTokens PasswordResetToken[]
  savedArticles       SavedArticle[]
  savedWellness       SavedWellness[]
  savedClips          SavedClip[]
  hepPrograms         HepProgram[]
  hepTemplates        HEPTemplate[]
  readArticles        ReadArticle[]
  boardActivity       BoardActivity[]
  gameActivity        GameActivity[]
  dailyCompletions    DailyCompletion[]
  calendarEvents      UserCalendarEvent[]
  vitalsProfile       VitalsProfile?
  vitalsLogs          VitalsLog[]
  metricsLogs         MetricsLog[]
  ceLogs              CELog[]
  foundingFunder      FoundingFunder?

  connectionsSent     Connection[]       @relation("ConnectionRequester")
  connectionsReceived Connection[]       @relation("ConnectionRecipient")
  nexusPosts          NexusPost[]
  nexusPostLikes      NexusPostLike[]
  nexusPostComments   NexusPostComment[]
  messagesSent        NexusMessage[]     @relation("MessageSender")
  messagesReceived    NexusMessage[]     @relation("MessageRecipient")
}

// A PT license submitted through the post-signup verification flow (see
// app/actions/license.ts, components/AddLicenseModal.tsx, app/(app)/admin/licenses/page.tsx)
// — one row per state a reader is licensed in, since a PT can hold licenses in more than one
// state but never two active licenses in the same state. @@unique([userId, state]) is what
// actually enforces that; a "rejected" row for a state doesn't block resubmitting that same
// state (see submitLicenseVerification), it's updated in place rather than blocked.
// licenseNumber stays globally unique (not just per user) for the same reason it was unique
// on User before this: a real license number belongs to exactly one person.
model License {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  state         String
  licenseNumber String    @unique
  fullName      String
  // "pending" | "verified" | "rejected" (see lib/license-verification.ts LICENSE_STATUSES)
  status        String    @default("pending")
  attestation   Boolean   @default(false)
  submittedAt   DateTime  @default(now())
  verifiedAt    DateTime?

  @@unique([userId, state])
}

// A connection request between two users, PT-network-style — "pending" until the
// recipient accepts or declines. Messaging is gated on status == "accepted" (see
// app/actions/nexus.ts).
model Connection {
  id          String    @id @default(cuid())
  requesterId String
  requester   User      @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("ConnectionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  status      String    @default("pending") // pending | accepted | declined
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([requesterId, recipientId])
}

// A Nexus feed post. Seeded rows carry sourceUrl/sourceLabel pointing at the real
// external piece they summarize (a real clinician's real published post) — never a
// fabricated quote, same integrity standard as the rest of the app's content. User-authored
// posts leave both null.
model NexusPost {
  id          String   @id @default(cuid())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  // "text" | "photo" | "video" | "article" — drives which extra fields below are used and
  // how NexusPostCard renders the post; a plain text post ignores all of them.
  type        String   @default("text")
  body        String
  // Article posts only.
  articleTitle String?
  // JSON-encoded string[] of data-URL images — photo posts (1-4 images) and an optional
  // single article cover image. Stored inline (not on disk/object storage) since this app
  // has no file storage configured; images are client-side compressed before upload to
  // keep rows reasonably sized (see lib/media-upload.ts).
  imageUrls   Json     @default("[]")
  // Video posts only — a YouTube URL, embedded the same way as Clips (see lib/meta.ts
  // youtubeEmbedUrl). No raw video upload/storage, for the same reason images are data URLs
  // instead of files: nowhere to durably store large binaries in this deployment.
  videoUrl    String?
  sourceUrl   String?
  sourceLabel String?
  createdAt   DateTime @default(now())

  likes    NexusPostLike[]
  comments NexusPostComment[]
}

model NexusPostLike {
  id        String    @id @default(cuid())
  postId    String
  post      NexusPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([postId, userId])
}

model NexusPostComment {
  id        String    @id @default(cuid())
  postId    String
  post      NexusPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime  @default(now())
}

// A direct message between two connected users. senderId/recipientId, not a thread id —
// a "conversation" is just every row where the two ids match either side (see
// lib/nexus.ts).
model NexusMessage {
  id          String    @id @default(cuid())
  senderId    String
  sender      User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  body        String
  createdAt   DateTime  @default(now())
  readAt      DateTime?
}

model SavedArticle {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId String
  createdAt DateTime @default(now())

  // A snapshot of the article's display fields taken at save time — live-sourced articles
  // (Google News guideline/industry/product, PubMed research) aren't guaranteed to still be
  // in the current live fetch batch by the time the reader revisits Saved Articles/
  // Guidelines, so display can't depend on re-resolving articleId against a fresh fetch
  // indefinitely (see app/actions/saved.ts). Null on rows saved before this existed, or on
  // non-article saves (wellness/clips), which fall back to best-effort live resolution.
  type      String?
  specialty String?
  title     String?
  source    String?
  sourceUrl String?
  date      String?
  readMins  Int?
  summary   String?
  tags      Json?

  @@unique([userId, articleId])
}

// A reader's own Limbic Calendar entries (see app/(app)/calendar/page.tsx) — both
// manually added via the Add Event modal and "Save to my calendar" copies of a PT
// platform event (see app/actions/calendar.ts). `type` is a free-text label chosen from
// the Add Event modal's select (Personal | CE Event | Conference | Rotation | Other), not
// an enum — same "no DB-level constraint, whitelist enforced in the server action"
// approach as every other free-text field in this schema (see profile.ts's
// PROFESSIONAL_DATE_FIELDS/EDITABLE_FIELDS pattern).
model UserCalendarEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  date      DateTime
  type      String
  notes     String?
  reminder  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Limbic Vitals (see app/(app)/wellness/metrics/page.tsx) — general wellness tracking, not
// medical advice or condition-specific. VitalsProfile is the reader's self-reported body
// metrics (one row per user); VitalsLog is one row per logged activity, aggregated
// client-side into the weekly bar chart rather than pre-summarized here, same "store the
// raw rows, derive views on read" approach as ReadArticle/BoardActivity elsewhere in this
// schema.
model VitalsProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  age           Int?
  heightFeet    Int?
  heightInches  Int?
  weightLbs     Float?
  biologicalSex String?
  activityLevel String?
  wellnessGoal  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model VitalsLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  category  String // "cardio" | "strength" | "mobility" | "mindfulness"
  minutes   Int
  activity  String
  notes     String?
  createdAt DateTime @default(now())
}

// Limbic Metrics (see app/(app)/wellness/metrics/page.tsx) — one row per calculator result
// or self-assessment score a reader chooses to save, same "raw rows, derive views on read"
// shape as VitalsLog above rather than one wide row per user. `metric` has no DB-level
// enum, same reasoning as VitalsLog's `category` — checked against a documented string
// union in the write path instead (see lib/metrics.ts).
model MetricsLog {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  metric   String // "bmi" | "hrv" | "vo2max" | "restingHR" | "maxHR" | "singleLegStance" | "sitAndRise" | "wallSit" | "shoulderScratch"
  value    Float
  notes    String?
  loggedAt DateTime @default(now())
}

// A single logged CE course entry for LimbicPRO's CE Hours Tracker (/pro/ce-tracker) —
// one row per course, added via addCELog/deleted via deleteCELog (see
// app/actions/pro-toolbox.ts). Hours logged toward renewal is the sum of these rows;
// license/cycle/required-hours preferences live on User (ceState/ceLicenseExpiry/
// ceRenewalCycle/ceTotalRequired above), not here, since they're one value per user rather
// than one per entry.
model CELog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseName  String
  provider    String?
  completedAt DateTime
  hours       Float
  category    String
  createdAt   DateTime @default(now())

  // The completion certificate, if the reader attached one — a data URL (image or PDF),
  // same "no file storage configured for this app" pattern as NexusPost.imageUrls (see
  // lib/media-upload.ts), capped client- and server-side (see MAX_CERTIFICATE_DATA_URL_LENGTH
  // in app/actions/pro-toolbox.ts) so a full-resolution scan doesn't blow past
  // next.config.ts's server-action body size limit. Optional — a log entry is still useful
  // for hour-tracking on its own, e.g. for a course whose certificate arrives later by mail.
  certificateDataUrl String?
}

// A bookmark on a Health & Wellness article or video, snapshot at save time — same
// reasoning as SavedArticle's snapshot: wellness content rotates per-user (see
// lib/wellness-rotation.ts) and isn't guaranteed to still be in anyone's current pool by
// the time the reader revisits Saved Wellness. Kept as its own model rather than folded
// into SavedArticle since wellness items have no specialty/ArticleType and videos carry a
// duration instead of a readMins/summary — a dedicated shape beats optional fields that
// only make sense for one kind or the other.
model SavedWellness {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    String
  kind      String // "article" | "video"
  createdAt DateTime @default(now())

  title     String
  source    String
  // Null for a saved seed wellness article (id "w1".."w4") — those have no external story,
  // they link to our own /wellness/[id] instead (see getWellnessArticleById); keeping this
  // null rather than faking an internal path lets WellnessListItem's sourceUrl-presence
  // check still correctly route back to that page instead of misreading it as external.
  sourceUrl String?
  date      String?
  readMins  Int?
  summary   String?
  duration  String?

  @@unique([userId, itemId])
}

// A bookmark on a Clips short — snapshot at save time, same reasoning as SavedWellness.
// A dedicated model rather than reusing SavedWellness since a clip carries a specialty
// (for the Clips feed's tag) instead of a duration/readMins/summary.
model SavedClip {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clipId    String
  createdAt DateTime @default(now())

  title     String
  source    String
  url       String
  specialty String

  @@unique([userId, clipId])
}

// Per-user, per-day completion state for Daily Term (Wordle) and Limbic Boards' question
// and term of the day — replaces what used to be tracked only in localStorage under an
// unscoped "limbic:wordle:<dateKey>"-style key, which meant every account on the same
// browser saw (and overwrote) the same "completed" state instead of each user having
// their own. elapsedSeconds is the time from first interaction to completion, captured so
// it can be shared to the Nexus feed (see app/actions/daily-completion.ts).
model DailyCompletion {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // "wordle" | "boardQuestion" | "boardTerm" | "crossword"
  dateKey   String
  createdAt DateTime @default(now())

  // Wordle-specific.
  guesses Json? // string[]
  status  String? // "won" | "lost"

  // boardQuestion-specific.
  selectedIndex Int?

  // crossword-specific — the full 5x5 grid of what the reader has typed so far ("" for a
  // black cell or one they haven't filled in yet), so an in-progress solve survives a
  // refresh the same way Wordle's guesses do. `status` above doubles for this kind too
  // ("won" once every cell matches the solution — there's no "lost" state, unlike Wordle).
  crosswordCells Json? // string[][]

  elapsedSeconds Int?

  @@unique([userId, kind, dateKey])
}

model HepProgram {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  programName String
  createdAt   DateTime      @default(now())
  exercises   HepExercise[]
}

// One row per article a user has opened — drives both the reading-streak counter and
// "saved but still unread" resurfacing, distinct from SavedArticle (a bookmark, not a
// read receipt).
model ReadArticle {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId String
  createdAt DateTime @default(now())
  // 0-1 fraction of the article's scroll extent the reader last reached — drives the Home
  // page "Continue Reading" card (see components/ReadingProgressTracker.tsx, which reports
  // it, and components/ContinueReadingCard.tsx, which renders it).
  scrollProgress Float    @default(0)
  // Bumped on every write to this row, including a bare re-open (see lib/reading.ts
  // recordArticleRead's upsert) as well as a progress update — "most recently touched",
  // not "first read", is what Continue Reading should surface.
  updatedAt      DateTime @default(now()) @updatedAt

  @@unique([userId, articleId])
}

// One row per day a user engages with Limbic Boards (answers the daily question and/or
// reveals the daily term) — drives the Boards streak/calendar the same way ReadArticle
// drives the reading one. Unique per (userId, dateKey) so answering the question and
// revealing the term on the same day only ever counts as one day of activity.
model BoardActivity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateKey   String
  createdAt DateTime @default(now())

  @@unique([userId, dateKey])
}

// One row per day a user finishes at least one Limbic Games game (Daily Term, Mini
// Crossword, or Case of the Day) — drives the Games streak/calendar the same way
// BoardActivity drives the Boards one. Unique per (userId, dateKey) so finishing more than
// one game the same day still only counts as one day of activity.
model GameActivity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateKey   String
  createdAt DateTime @default(now())

  @@unique([userId, dateKey])
}

// A clinician-created grouping of Clinical Calculators results for one visit/patient (see
// /pro/calculators' right-side panel, components/pro/calculators/CalculatorProfilesPanel.tsx)
// — deliberately just a free-text `label`, never a real patient name/DOB/MRN field, so
// nothing here is itself PHI: the clinician is expected to use a non-identifying label
// (initials, room number, session code), same "we don't collect what we don't need"
// reasoning as the rest of this app never asking for identifying patient details anywhere
// else either.
model CalculatorProfile {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  label  String
  // JSON-encoded string[] of calculator testKeys (see lib/calculator-tests.ts) the
  // clinician planned to run for this profile — a checklist, not an access-control list;
  // a result can still be saved for a test that isn't on it (see saveCalculatorResultAction
  // in app/actions/calculator-profiles.ts).
  selectedTests Json     @default("[]")
  createdAt     DateTime @default(now())
  results       CalculatorResult[]
}

// One reader's answer to one Board Connections practice question (see
// components/specialty/SpecialtyBoardConnections.tsx and app/actions/specialty-questions.ts)
// on one of the /student/specialties pages — specialty is the route slug (e.g.
// "musculoskeletal", "sports"; every /specialties/sports/<sport> sub-page shares "sports",
// same as they share that hub's specialtyQuestions pool) and questionIndex is that
// question's position within lib/board-content.ts questionsForSpecialty(specialty), which is
// a fixed filter over a static array so the index is stable day to day. dateKey (YYYY-MM-DD)
// is what makes the daily reset automatic — getSpecialtyAnswers only ever reads today's
// dateKey, so a new (userId, specialty, questionIndex, dateKey) row just naturally starts
// unanswered once the date rolls over; nothing deletes or resets the old rows, they just
// stop being read, same pattern as DailyCompletion/BoardActivity elsewhere in this file.
model SpecialtyQuestionAnswer {
  id             String   @id @default(cuid())
  userId         String
  specialty      String
  questionIndex  Int
  selectedAnswer String
  isCorrect      Boolean
  answeredAt     DateTime @default(now())
  dateKey        String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, specialty, questionIndex, dateKey])
}

// One row per calendar day (dateKey, YYYY-MM-DD) — the day's case for the Differential
// game (see lib/differential-cases.ts getTodaysCase/getDateKey, app/games/differential).
// caseIndex/condition/clues/category/difficulty are a denormalized snapshot of that day's
// entry from the static case bank at the moment it was first served, so a later edit to
// the static array can't retroactively change what a past day's row says was asked.
model DifferentialCase {
  id         String   @id @default(cuid())
  dateKey    String   @unique
  caseIndex  Int
  condition  String
  clues      Json
  category   String
  difficulty String
  createdAt  DateTime @default(now())
}

// One row per (user, day) — same "first finish wins, nothing resets until the date rolls
// over" pattern as SpecialtyQuestionAnswer above. guesses stores every guess the reader
// submitted that day (in order) so a wrong-then-right sequence is fully recoverable, not
// just the final outcome.
model DifferentialResult {
  id          String   @id @default(cuid())
  userId      String
  dateKey     String
  cluesUsed   Int
  correct     Boolean
  guesses     Json
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey])
}

// One row per calendar day — the day's puzzle for Anatomy Connect (see
// lib/anatomy-connect-logic.ts getTodaysPuzzle/getDateKey, app/games/anatomy-connect).
// `puzzle` is a denormalized snapshot of that day's static-bank entry (title/size/items),
// same reasoning as DifferentialCase above — a later edit to the static array can't
// retroactively change what a past day's puzzle was.
model AnatomyConnectPuzzle {
  id        String   @id @default(cuid())
  dateKey   String   @unique
  puzzle    Json
  createdAt DateTime @default(now())
}

// One row per (user, day) — same "first finish wins" pattern as DifferentialResult above.
model AnatomyConnectResult {
  id          String   @id @default(cuid())
  userId      String
  dateKey     String
  solved      Boolean
  attempts    Int
  timeSeconds Int
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey])
}

// One saved score for one CalculatorProfile — testKey/testName identify which of the 12
// /pro/calculators tools produced it (see lib/calculator-tests.ts for the canonical list);
// value/interpretation are the exact display strings the calculator itself showed at save
// time (e.g. value "41 / 56", interpretation "Low fall risk, 41-56 low, 21-40 medium,
// 0-20 high fall risk") rather than a bare number, so retrieving this later reads the same
// way the clinician saw it live, without this table needing to know each test's own
// scoring scale/units.
model CalculatorResult {
  id             String            @id @default(cuid())
  profileId      String
  profile        CalculatorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  testKey        String
  testName       String
  value          String
  interpretation String
  completedAt    DateTime          @default(now())
}

model HepExercise {
  id        String     @id @default(cuid())
  programId String
  program   HepProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  name      String
  sets      String
  reps      String
  notes     String
  order     Int        @default(0)
  // LimbicPRO-only (see createHepAction, which only ever persists these for user.isPro —
  // a non-pro clinician can still build a text-only HEP, just without attaching media).
  // Links, not uploaded files — this app has no file/blob storage anywhere, so both are
  // just a URL the clinician pastes in (an image URL, and a YouTube/Vimeo/etc. video URL).
  imageUrl String?
  videoUrl String?
}

// A saved HEP Builder draft a clinician can reload into the builder later, organized by
// body part in the /hep template library panel (see components/HepTemplateLibrary.tsx).
// Distinct from HepProgram/HepExercise above — a HepProgram is a finished program that's
// been saved for a patient, while a HEPTemplate is a reusable starting point (its
// exercises are never linked to a real HepExercise row, just a JSON snapshot of the
// builder's draft state at save time).
model HEPTemplate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  // One of the fixed body part categories the template panel groups by — see
  // HEP_TEMPLATE_BODY_PARTS in lib/hep-templates.ts. Plain String (not an enum) to match
  // this schema's existing convention for fixed-but-app-enforced value sets (see
  // FoundingFunder.paymentStatus, ConnexionVisitRequest.status).
  bodyPart  String
  // JSON snapshot of the builder's draft exercises at save time — same shape as
  // HepBuilder's DraftExercise minus the client-only `id` field.
  exercises Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One of the 25 "Founding 25" spots on /founding-funders. Created two ways: self-serve via
// createFoundingFunderCheckout (a real one-time $40 Stripe Checkout, see
// app/actions/founding-funders.ts and app/api/stripe/webhook/route.ts), or manually by an
// admin via claimFoundingSpotAction once an out-of-band payment is confirmed. displayName/
// credential are captured at claim time rather than read live off User (name/specialty) so
// the founding-grid entry stays exactly what was agreed even if the reader later edits their
// profile. `round`/`amount` exist for a possible second cohort after these 25 fill — unused
// (always round 1, amount 40) until that happens.
model FoundingFunder {
  id     String  @id @default(cuid())
  // Nullable, onDelete: SetNull (not Cascade) — deliberately: the /founding-funders page
  // itself promises the Founding 25 listing is permanent ("your name in Limbic forever"),
  // so deleting the underlying account (see app/actions/profile.ts deleteAccountAction)
  // detaches this row from any login instead of erasing it. displayName/credential were
  // already public (the reader/admin chose to show them in the grid), so keeping them
  // around isn't exposing anything new. Also left null entirely for a self-serve Stripe
  // claim — that flow never requires an existing Limbic account (see createFoundingFunderCheckout).
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  displayName String
  credential  String?
  round       Int      @default(1)
  amount      Int      @default(40)
  claimedAt   DateTime @default(now())
  // Kept alongside paymentStatus below (always true when paymentStatus is "confirmed",
  // false otherwise) purely for backward compatibility with existing reads/writes that
  // predate paymentStatus — paymentStatus is the real source of truth for the grid/admin's
  // three-state (empty/pending/confirmed) display.
  confirmed   Boolean  @default(false)

  /// "pending" | "confirmed" | "failed" — set to "pending" the moment a Stripe Checkout
  /// Session is created (createFoundingFunderCheckout), flipped to "confirmed" by the
  /// checkout.session.completed webhook (or the /founding-funders success-page backup check,
  /// or an admin's manual "Confirm Payment" override). A row an admin claims directly
  /// (claimFoundingSpotAction, no Stripe involved) is created already "confirmed". Pending
  /// rows count toward the 25-spot cap the same as confirmed ones, so a spot can't be
  /// oversold while a Checkout Session is still in flight.
  paymentStatus   String    @default("pending")
  stripeSessionId String?
  stripePaymentId String?
  confirmedAt     DateTime?

  // Assigned once, at the moment paymentStatus first becomes "confirmed" (see
  // lib/founding-funders.ts nextFoundingFunderNumber) — the count of already-confirmed
  // funders at that moment, plus one. Null for a pending/failed row. Powers "Founding
  // Funder No. {number}" on Profile (see components/FoundingFunderBadge.tsx) — the short
  // pill shown elsewhere in the app (feed, comments) omits the number.
  foundingFunderNumber Int?
}

// A pre-launch email signup for /founding-funders, collected while
// lib/founding-funders-config.ts's FOUNDING_FUNDERS_OPEN is still false. Deliberately not
// tied to a User — a visitor can join the waitlist without an account existing yet (though
// in practice the page itself is sign-in gated; this just doesn't assume that stays true).
model FoundingFunderWaitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// A home-visit request submitted from The Connexion Method's scheduling form — see
// ConnexionScheduleSection.tsx (embedded on /connexion, /connexion/safety-score, and
// /connexion/delia) and submitVisitRequest in app/actions/connexion.ts. Not tied to a
// User (same reasoning FoundingFunderWaitlist/the old ConnexionWaitlist this replaces
// used) — a visitor can request a visit without a Limbic account existing at all in
// principle, even though every page the form lives on is sign-in gated in practice.
// `status` is a plain admin-managed string, not an enum, matching FoundingFunder's own
// paymentStatus field — see /admin/connexion-visits, updateVisitRequestStatusAction.
model ConnexionVisitRequest {
  id            String    @id @default(cuid())
  name          String
  phone         String
  email         String
  preferredDate DateTime?
  preferredTime String?
  visitReason    String?  // dropdown value instead of free text
  status        String    @default("new") // "new" | "contacted" | "scheduled" | "completed"
  createdAt     DateTime  @default(now())
}

// A fixed-window request counter for "Continue as guest" (see lib/guest-rate-limit.ts,
// guestSignInAction in app/actions/auth.ts) — one row per IP, capping how many throwaway
// guest accounts a single address can mint per window. Not meant to be precise (reads then
// writes count, not atomically incremented under a DB-level lock) — good enough to blunt a
// script hammering the button, which is all this needs to do.
model GuestSignupThrottle {
  ip          String   @id
  windowStart DateTime
  count       Int      @default(1)
}

// Fixed-window failed-sign-in-attempt counter, keyed by the lowercased/trimmed email that
// was attempted (see lib/sign-in-rate-limit.ts, signInAction in app/actions/auth.ts) — same
// shape as GuestSignupThrottle above, just per-email instead of per-IP, and reset on a
// successful sign-in rather than only ever aging out.
model SignInThrottle {
  email       String   @id
  windowStart DateTime
  count       Int      @default(1)
}

// Fixed-window password-reset-request counter, keyed the same way as SignInThrottle above
// (see lib/password-reset-rate-limit.ts, requestPasswordResetAction in
// app/actions/auth.ts) — caps how many reset emails one address can trigger per window,
// independent of whether the address actually has an account (an attacker can't tell the
// difference from the outside, so this counts every request attempt, not just ones that
// found a real user).
model PasswordResetThrottle {
  email       String   @id
  windowStart DateTime
  count       Int      @default(1)
}

// A password-reset link's server-side half (see lib/password.ts, app/actions/auth.ts
// requestPasswordResetAction/resetPasswordAction) — one row per emailed link. Only
// `tokenHash` (a SHA-256 hash of the random token that's actually emailed) is ever stored,
// same reasoning as never storing a plaintext password: a database leak alone can't be
// used to reset anyone's account. Doubles as the migration path for every account that
// predates passwordHash existing (see User.passwordHash) — there's no separate "claim your
// legacy account" flow, a legacy sign-in attempt just routes to the same request-a-reset
// UI a normal "forgot password" would.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// The Profile page's anonymous Suggestion Box (see submitSuggestionAction in
// app/actions/suggestions.ts, the admin-only listing at app/(app)/admin/suggestions) —
// deliberately has no userId/user relation at all, unlike every other per-account model in
// this schema, so a submission can never be traced back to the account that sent it, even
// by an admin reading the raw table. Only visible to a site admin (see lib/admin.ts
// isSiteAdmin), same access pattern as FoundingFunderWaitlist above.
model Suggestion {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())
}
