// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  isGuest           Boolean  @default(false)

  licenseNumber     String?  @unique
  licenseState      String?
  licenseEmail      String?
  licenseExpiration DateTime?

  // General (non-PT) sign-in — separate from licenseEmail, which belongs to the PT flow
  // and isn't unique. Signing in again with the same email returns to this same account,
  // same persistence model as licenseNumber for PTs.
  email             String?  @unique

  name              String   @default("Dr. Amara Chen, PT")
  specialty         String   @default("ortho")
  practiceState     String   @default("California")

  // JSON-encoded string[] of followed topics
  followedTopics    Json     @default("[]")
  // JSON-encoded { name, required, completed }[] of CE categories
  ceCategories      Json     @default("[]")

  // LimbicPro — currently flipped by a demo action (see app/actions/pro.ts), not real
  // billing. This field is the intended seam for real payment later: a webhook would set
  // it instead of the demo action, and nothing else in the app needs to change.
  isPro             Boolean  @default(false)

  // Student tiers — "none" | "studentPro" | "studentProBoards" (a superset of studentPro).
  // Only purchasable/visible for accounts signed in with a .edu email (see
  // lib/session.ts isStudentEmail) — Limbic Boards and Daily Term are gated on that check,
  // not on this field, since the tier is about what's purchasable, not who can sign in.
  // Same demo-purchase pattern as isPro (see app/actions/pro.ts).
  studentTier       String   @default("none")

  // Timestamp of the previous home-feed load, captured before it's overwritten with the
  // current one — this is what lets the feed tell "published since you were last here"
  // apart from everything else (see lib/session.ts recordVisitAndGetPrevious).
  lastVisitedAt     DateTime?

  // Daily reading-streak tracking, both driven by lib/streak.ts off ReadArticle rows.
  lastReadAt        DateTime?
  streakDays        Int      @default(0)

  // Nexus (networking) profile fields — blank for accounts that haven't set them up.
  headline          String?
  bio               String?
  // Consent gate: false until the user explicitly joins Nexus (see app/actions/nexus.ts
  // optInToNexusAction/leaveNexusAction) — controls whether they show up in the directory
  // or suggestions, and whether they can view/use any /nexus page at all. Always true for
  // seeded demo/real profiles (see lib/nexus-seed.ts), which can't log in to opt in
  // themselves.
  nexusOptIn        Boolean  @default(false)

  // JSON-encoded string[] of Home sidebar widget ids the user has hidden (see
  // components/HomeFeed.tsx HOME_WIDGETS) — opt-out, not opt-in, so the default empty array
  // means "show everything", same as every existing account before this field existed.
  hiddenHomeWidgets Json     @default("[]")

  // Limbic Boards (student daily-habit tools) streak — same nextStreak() logic as the
  // reading streak above, driven off BoardActivity rows instead of ReadArticle ones.
  lastBoardsActivityAt DateTime?
  boardsStreakDays     Int      @default(0)

  // The Health & Wellness page's current per-user rotation state (see
  // lib/wellness-rotation.ts). wellnessArticleIds/wellnessVideoIds are JSON-encoded
  // string[] of the ids currently displayed; wellnessOpenedIds is a JSON-encoded string[]
  // of every id the user has ever opened, bounded/pruned to the most recent entries — the
  // Refresh button keeps whatever's still unopened and swaps opened ones for ids outside
  // this list, rather than reshuffling the whole page every time.
  wellnessArticleIds Json @default("[]")
  wellnessVideoIds   Json @default("[]")
  wellnessOpenedIds  Json @default("[]")

  // Every Clip id the user has scrolled past (see lib/clip-rotation.ts), bounded/pruned the
  // same way as wellnessOpenedIds. The curated CLIPS pool (lib/clips-static.ts) is small and
  // finite, so this can't guarantee never repeating — it's what lets the feed put
  // never-seen clips first each visit instead of always restarting from the same c1.
  clipsSeenIds Json @default("[]")

  savedArticles       SavedArticle[]
  savedWellness       SavedWellness[]
  savedClips          SavedClip[]
  hepPrograms         HepProgram[]
  readArticles        ReadArticle[]
  boardActivity       BoardActivity[]
  dailyCompletions    DailyCompletion[]

  connectionsSent     Connection[]       @relation("ConnectionRequester")
  connectionsReceived Connection[]       @relation("ConnectionRecipient")
  nexusPosts          NexusPost[]
  nexusPostLikes      NexusPostLike[]
  nexusPostComments   NexusPostComment[]
  messagesSent        NexusMessage[]     @relation("MessageSender")
  messagesReceived    NexusMessage[]     @relation("MessageRecipient")
}

// A connection request between two users, PT-network-style — "pending" until the
// recipient accepts or declines. Messaging is gated on status == "accepted" (see
// app/actions/nexus.ts).
model Connection {
  id          String    @id @default(cuid())
  requesterId String
  requester   User      @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("ConnectionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  status      String    @default("pending") // pending | accepted | declined
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([requesterId, recipientId])
}

// A Nexus feed post. Seeded rows carry sourceUrl/sourceLabel pointing at the real
// external piece they summarize (a real clinician's real published post) — never a
// fabricated quote, same integrity standard as the rest of the app's content. User-authored
// posts leave both null.
model NexusPost {
  id          String   @id @default(cuid())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  // "text" | "photo" | "video" | "article" — drives which extra fields below are used and
  // how NexusPostCard renders the post; a plain text post ignores all of them.
  type        String   @default("text")
  body        String
  // Article posts only.
  articleTitle String?
  // JSON-encoded string[] of data-URL images — photo posts (1-4 images) and an optional
  // single article cover image. Stored inline (not on disk/object storage) since this app
  // has no file storage configured; images are client-side compressed before upload to
  // keep rows reasonably sized (see lib/media-upload.ts).
  imageUrls   Json     @default("[]")
  // Video posts only — a YouTube URL, embedded the same way as Clips (see lib/meta.ts
  // youtubeEmbedUrl). No raw video upload/storage, for the same reason images are data URLs
  // instead of files: nowhere to durably store large binaries in this deployment.
  videoUrl    String?
  sourceUrl   String?
  sourceLabel String?
  createdAt   DateTime @default(now())

  likes    NexusPostLike[]
  comments NexusPostComment[]
}

model NexusPostLike {
  id        String    @id @default(cuid())
  postId    String
  post      NexusPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([postId, userId])
}

model NexusPostComment {
  id        String    @id @default(cuid())
  postId    String
  post      NexusPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime  @default(now())
}

// A direct message between two connected users. senderId/recipientId, not a thread id —
// a "conversation" is just every row where the two ids match either side (see
// lib/nexus.ts).
model NexusMessage {
  id          String    @id @default(cuid())
  senderId    String
  sender      User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  body        String
  createdAt   DateTime  @default(now())
  readAt      DateTime?
}

model SavedArticle {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId String
  createdAt DateTime @default(now())

  // A snapshot of the article's display fields taken at save time — live-sourced articles
  // (Google News guideline/industry/product, PubMed research) aren't guaranteed to still be
  // in the current live fetch batch by the time the reader revisits Saved Articles/
  // Guidelines, so display can't depend on re-resolving articleId against a fresh fetch
  // indefinitely (see app/actions/saved.ts). Null on rows saved before this existed, or on
  // non-article saves (wellness/clips), which fall back to best-effort live resolution.
  type      String?
  specialty String?
  title     String?
  source    String?
  sourceUrl String?
  date      String?
  readMins  Int?
  summary   String?
  tags      Json?

  @@unique([userId, articleId])
}

// A bookmark on a Health & Wellness article or video, snapshot at save time — same
// reasoning as SavedArticle's snapshot: wellness content rotates per-user (see
// lib/wellness-rotation.ts) and isn't guaranteed to still be in anyone's current pool by
// the time the reader revisits Saved Wellness. Kept as its own model rather than folded
// into SavedArticle since wellness items have no specialty/ArticleType and videos carry a
// duration instead of a readMins/summary — a dedicated shape beats optional fields that
// only make sense for one kind or the other.
model SavedWellness {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    String
  kind      String // "article" | "video"
  createdAt DateTime @default(now())

  title     String
  source    String
  // Null for a saved seed wellness article (id "w1".."w4") — those have no external story,
  // they link to our own /wellness/[id] instead (see getWellnessArticleById); keeping this
  // null rather than faking an internal path lets WellnessListItem's sourceUrl-presence
  // check still correctly route back to that page instead of misreading it as external.
  sourceUrl String?
  date      String?
  readMins  Int?
  summary   String?
  duration  String?

  @@unique([userId, itemId])
}

// A bookmark on a Clips short — snapshot at save time, same reasoning as SavedWellness.
// A dedicated model rather than reusing SavedWellness since a clip carries a specialty
// (for the Clips feed's tag) instead of a duration/readMins/summary.
model SavedClip {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clipId    String
  createdAt DateTime @default(now())

  title     String
  source    String
  url       String
  specialty String

  @@unique([userId, clipId])
}

// Per-user, per-day completion state for Daily Term (Wordle) and Limbic Boards' question
// and term of the day — replaces what used to be tracked only in localStorage under an
// unscoped "limbic:wordle:<dateKey>"-style key, which meant every account on the same
// browser saw (and overwrote) the same "completed" state instead of each user having
// their own. elapsedSeconds is the time from first interaction to completion, captured so
// it can be shared to the Nexus feed (see app/actions/daily-completion.ts).
model DailyCompletion {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // "wordle" | "boardQuestion" | "boardTerm"
  dateKey   String
  createdAt DateTime @default(now())

  // Wordle-specific.
  guesses Json? // string[]
  status  String? // "won" | "lost"

  // boardQuestion-specific.
  selectedIndex Int?

  elapsedSeconds Int?

  @@unique([userId, kind, dateKey])
}

model HepProgram {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  programName String
  createdAt   DateTime      @default(now())
  exercises   HepExercise[]
}

// One row per article a user has opened — drives both the reading-streak counter and
// "saved but still unread" resurfacing, distinct from SavedArticle (a bookmark, not a
// read receipt).
model ReadArticle {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleId String
  createdAt DateTime @default(now())
  // 0-1 fraction of the article's scroll extent the reader last reached — drives the Home
  // page "Continue Reading" card (see components/ReadingProgressTracker.tsx, which reports
  // it, and components/ContinueReadingCard.tsx, which renders it).
  scrollProgress Float    @default(0)
  // Bumped on every write to this row, including a bare re-open (see lib/reading.ts
  // recordArticleRead's upsert) as well as a progress update — "most recently touched",
  // not "first read", is what Continue Reading should surface.
  updatedAt      DateTime @default(now()) @updatedAt

  @@unique([userId, articleId])
}

// One row per day a user engages with Limbic Boards (answers the daily question and/or
// reveals the daily term) — drives the Boards streak/calendar the same way ReadArticle
// drives the reading one. Unique per (userId, dateKey) so answering the question and
// revealing the term on the same day only ever counts as one day of activity.
model BoardActivity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateKey   String
  createdAt DateTime @default(now())

  @@unique([userId, dateKey])
}

model HepExercise {
  id        String     @id @default(cuid())
  programId String
  program   HepProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  name      String
  sets      String
  reps      String
  notes     String
  order     Int        @default(0)
}
